{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "┌──────────────┐\n│              │\n│     WARD     │\n│              │\n└──────────────┘",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 12 },
    "size": { "binaryPrefix": "iec" },
    "percent": { "type": 9 },
    "bar": { "borderLeft": "", "borderRight": "", "charElapsed": "━", "charTotal": "─", "width": 12 }
  },
  "modules": [
    { "type": "custom", "format": "WardOS. Agents visible, constrained, verifiable." },
    "break",
    { "type": "title", "key": "user", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "os", "format": "{name} {version}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "command", "key": "image", "text": "bootc status --format json 2>/dev/null | jq -r '.status.booted.image.image.image // \"not booted from an image\"'" },
    { "type": "command", "key": "ward", "text": "ward --version 2>/dev/null || echo unavailable" },
    { "type": "uptime", "key": "uptime" },
    "break",
    { "type": "wm", "key": "compositor" },
    { "type": "terminal", "key": "terminal" },
    { "type": "shell", "key": "shell" },
    { "type": "command", "key": "theme", "text": "wardos-theme current 2>/dev/null || echo ward-dark" },
    { "type": "font", "key": "font" },
    "break",
    { "type": "host", "key": "host" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
