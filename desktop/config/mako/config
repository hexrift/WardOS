# WardOS — notifications and approvals (docs/design-language.md §9, §10).
#
# Calm, top-right, under the bar, on the 8 px grid, 1 px border, no icons by default.
# Colours, the font and the radius come from the theme fragment included first
# (background-color, text-color, border-color, progress-color, font, border-radius):
# mako reads `include=` only in the global section, before the first [criteria] (an
# include after one is "Failed to parse option" and the whole config is refused), and
# the fragment's own [urgency=…] sections then come before the ones below, which add
# to them (timeouts here, colours there) rather than replace them.
# Approvals from wardos-approve use the `ward-approval` category: centred, they stay
# until answered, and their timeout is a thin progress line, not a number (§10).
# Denials (§9) are short and never urgent-red on the whole surface.

include=~/.config/wardos/theme/current/mako.conf

max-visible=4
sort=-time
layer=overlay
anchor=top-right
output=
margin=8,8,0,0
padding=8,16
width=360
height=160
border-size=1
icons=0
markup=1
actions=1
default-timeout=6000
ignore-timeout=0
group-by=app-name
format=<b>%s</b>\n%b

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0

# The approval layout of §10 as a style: the title (`<Agent> requests`, the summary)
# over the body wardos-approve sends (the target on its own line, then the `Reason`
# and `Scope` rows; the target is expected wrapped in <tt> so it reads in the mono
# face, §4), then the three actions with their keys, dimmed, as one row. mako draws
# no buttons: y / s / n answer through wardos-approve, and the row says so.
[category=ward-approval]
default-timeout=0
ignore-timeout=1
layer=overlay
anchor=center
width=520
height=320
padding=16,24
format=<b>%s</b>\n\n%b\n\n<span alpha="39322">Allow once  <b>y</b>      Allow session  <b>s</b>      Deny  <b>n</b></span>

# Toasts for finished work (wardos-notify --done).
[category=ward-done]
default-timeout=3000

# Do-not-disturb mode set by `wardos-toggle notifications` (makoctl mode -s dnd).
[mode=dnd]
invisible=1
