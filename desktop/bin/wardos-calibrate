#!/usr/bin/env bash
# wardos-calibrate — in-session system settings: CALIBRATE (docs/desktop.md §Commands,
# ADR-0026). The first-boot *provisioning* form (before any human account exists) is
# wardos-provision-ui (ADR-0027); both share the pickers in lib/calibrate.sh.
#
# Usage: wardos-calibrate [--force] [STEP…]
#   wardos-calibrate            the guided flow once (language, keyboard, timezone, then a
#                               review that can change any choice or set a password), then
#                               the marker ~/.config/wardos/calibrate-done. Nothing once the
#                               marker exists.
#   wardos-calibrate --force    the guided flow again, marker or not
#   wardos-calibrate locale     one step, any time: locale | keyboard | timezone | password
#   wardos-calibrate STEP VALUE apply a step non-interactively (e.g. `timezone Europe/Paris`,
#                               `locale de_DE.UTF-8`, `keyboard fr`) — scriptable and tested.
#
# Keyboard-first: every question is a wardos-menu-select menu (mouse works too), so the
# normal path never opens a terminal; only the optional password step does, exactly as the
# key step in wardos-welcome does. Every system change goes through polkit (localectl /
# timedatectl talk to systemd over D-Bus and the session's polkit agent authorises), never
# sudo. Each apply is best-effort: a failure is reported and the flow continues. Nothing
# here needs the network.
set -euo pipefail
# shellcheck source=desktop/lib/wardos.sh disable=SC1091
source "${WARDOS_LIB:-$(dirname "$(readlink -f "$0")")/../lib/wardos.sh}" 2>/dev/null ||
  source /usr/lib/wardos/wardos.sh
# shellcheck source=desktop/lib/calibrate.sh disable=SC1091
source "${WARDOS_CALIBRATE_LIB:-$(dirname "$(readlink -f "$0")")/../lib/calibrate.sh}" 2>/dev/null ||
  source /usr/lib/wardos/calibrate.sh
wardos_help "$@"

marker="$(wardos_config_dir)/calibrate-done"

# --- apply helpers: each prints a warning and returns non-zero on failure, never exits ---

apply_locale() {
  local loc=$1
  [[ -n "$loc" ]] || return 0
  if localectl set-locale "LANG=$loc"; then
    wardos_notify "Language" "$loc (takes effect at the next login)"
  else
    wardos_notify "Language not set" "Could not apply $loc; try again from the menu"
    return 1
  fi
}

apply_keyboard() {
  local layout=$1 ok=0
  [[ -n "$layout" ]] || return 0
  # Validate against the supported layouts BEFORE any write: an unknown layout must never
  # be persisted into the user's config (the interactive picker only offers valid ones; a
  # non-interactive `keyboard <bad>` is rejected here, leaving all state untouched).
  if ! localectl list-x11-keymap-layouts 2>/dev/null | grep -qxF -- "$layout"; then
    wardos_notify "Keyboard" "Unknown layout '$layout'; nothing changed"
    return 1
  fi
  # The running Hyprland session, so the change is felt immediately.
  if wardos_has hyprctl; then hyprctl keyword input:kb_layout "$layout" >/dev/null 2>&1 || ok=1; fi
  # Persist it in the user's Hyprland input.conf (created from the default when missing).
  local conf
  conf=$(hypr_input_conf)
  if grep -Eq '^[[:space:]]*kb_layout[[:space:]]*=' "$conf"; then
    wardos_backup "$conf"
    sed -i -E "s|^([[:space:]]*kb_layout[[:space:]]*=[[:space:]]*).*$|\1$layout|" "$conf"
  fi
  # The console and the greeter (localectl, polkit).
  localectl set-x11-keymap "$layout" || ok=1
  if [[ $ok -eq 0 ]]; then
    wardos_notify "Keyboard" "$layout"
  else
    wardos_notify "Keyboard partly set" "$layout applied where it could be; check wardos-setup input"
    return 1
  fi
}

apply_timezone() {
  local tz=$1
  [[ -n "$tz" ]] || return 0
  if timedatectl set-timezone "$tz"; then
    wardos_notify "Timezone" "$tz"
  else
    wardos_notify "Timezone not set" "Could not apply $tz; try again from the menu"
    return 1
  fi
}

# keyboard-local LAYOUT: apply a validated layout to THIS user's Hyprland config only — the
# running session and input.conf, NOT the system keymap. Used on a provisioned user's first
# login (ADR-0027) to adopt the layout chosen at provisioning: the broker already set the
# system keymap, but wardos-refresh resets input.conf to the default, so the desktop needs
# the chosen layout re-applied here.
apply_keyboard_local() {
  local layout=$1
  [[ -n "$layout" ]] || return 0
  if ! localectl list-x11-keymap-layouts 2>/dev/null | grep -qxF -- "$layout"; then
    wardos_notify "Keyboard" "Unknown layout '$layout'; nothing changed"
    return 1
  fi
  if wardos_has hyprctl; then hyprctl keyword input:kb_layout "$layout" >/dev/null 2>&1 || true; fi
  local conf
  conf=$(hypr_input_conf)
  if grep -Eq '^[[:space:]]*kb_layout[[:space:]]*=' "$conf"; then
    wardos_backup "$conf"
    sed -i -E "s|^([[:space:]]*kb_layout[[:space:]]*=[[:space:]]*).*$|\1$layout|" "$conf"
  fi
}

# The user's copy of the shipped Hyprland input fragment, created from the default when
# missing (so a change to kb_layout always has a file to land in).
hypr_input_conf() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/input.conf"
  if [[ ! -f "$file" ]]; then
    mkdir -p "$(dirname "$file")"
    if [[ -f "$(wardos_hypr_dir)/input.conf" ]]; then
      cp "$(wardos_hypr_dir)/input.conf" "$file"
    else
      printf 'input {\n    kb_layout = us\n}\n' >"$file"
    fi
  fi
  printf '%s\n' "$file"
}

# The optional password step: one terminal window running passwd for the current user.
set_password() {
  if [[ -t 0 && -t 1 ]]; then
    passwd
  elif wardos_has wardos-launch; then
    wardos-launch run wardos-passwd passwd
  else
    wardos_notify "Set a password" "Run 'passwd' in a terminal"
  fi
}

# --- the guided flow: collect, review (change anything / password), apply ---------------

# The guided flow. Returns 0 only when the user reaches a confirmed terminal choice —
# "Apply and continue" (settings applied) or "Skip the rest" (a deliberate no-change
# finish). A cancelled review (the menu dismissed with Escape) returns non-zero and applies
# nothing, so the caller does NOT write the completion marker and the flow runs again next
# login rather than recording an unfinished setup as complete.
guided() {
  local loc="" kbd="" tz="" choice
  loc=$(calibrate_pick_locale) || true
  kbd=$(calibrate_pick_keyboard) || true
  tz=$(calibrate_pick_timezone) || true
  while true; do
    choice=$(wardos_menu "Review · your first-boot setup" \
      "Apply and continue" \
      "Language · ${loc:-keep current}" \
      "Keyboard · ${kbd:-keep current}" \
      "Timezone · ${tz:-keep current}" \
      "Set a login password" \
      "Skip the rest") || return 1 # cancelled: not completed, no marker
    case "$choice" in
      "Apply and continue")
        # Best-effort but result-aggregating: attempt every selected setting (a failure
        # notifies and never stops the others), then report whether ALL requested applies
        # succeeded. A non-zero return here means the caller does NOT write the completion
        # marker, so a machine left with an unapplied keyboard/locale/timezone is re-offered
        # CALIBRATE next login rather than silently recorded as done (#125). "keep current"
        # applies nothing and counts as success.
        local ok=0
        apply_locale "$loc" || ok=1
        apply_keyboard "$kbd" || ok=1
        apply_timezone "$tz" || ok=1
        return "$ok"
        ;;
      "Language ·"*) loc=$(calibrate_pick_locale) || true ;;
      "Keyboard ·"*) kbd=$(calibrate_pick_keyboard) || true ;;
      "Timezone ·"*) tz=$(calibrate_pick_timezone) || true ;;
      "Set a login password") set_password ;;
      "Skip the rest") return 0 ;;
      *) return 1 ;;
    esac
  done
}

run_step() {
  case "$1" in
    locale)
      local v=${2:-}
      [[ -n "$v" ]] || v=$(calibrate_pick_locale) || true
      apply_locale "$v"
      ;;
    keyboard)
      local v=${2:-}
      [[ -n "$v" ]] || v=$(calibrate_pick_keyboard) || true
      apply_keyboard "$v"
      ;;
    timezone)
      local v=${2:-}
      [[ -n "$v" ]] || v=$(calibrate_pick_timezone) || true
      apply_timezone "$v"
      ;;
    keyboard-local)
      apply_keyboard_local "${2:-}"
      ;;
    password) set_password ;;
    run) guided ;;
    *) wardos_die "no step '$1' (locale, keyboard, keyboard-local, timezone, password, run)" ;;
  esac
}

force=0
if [[ "${1:-}" == --force ]]; then
  force=1
  shift
fi

# A named step (with or without a value) runs on its own, any time, marker or not.
if [[ $# -gt 0 ]]; then
  run_step "$@"
  exit
fi

# The guided flow: once, unless --force. The marker is written ONLY when guided() reaches a
# confirmed terminal choice (Apply or Skip); a cancelled review leaves no marker, so an
# unfinished setup is never recorded as complete and the flow runs again next login.
if [[ -e "$marker" && $force -eq 0 ]]; then exit 0; fi
if guided; then
  mkdir -p "$(dirname "$marker")"
  date -u +%Y-%m-%dT%H:%M:%SZ >"$marker"
fi
