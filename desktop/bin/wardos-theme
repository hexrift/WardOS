#!/usr/bin/env bash
# wardos-theme — choose, cycle, install and render themes (docs/desktop.md §Themes).
#
# Usage:
#   wardos-theme list                ids of every theme, shipped and installed, sorted
#   wardos-theme current             the id in use (ward-dark until one is set)
#   wardos-theme set <id>            render <id> into ~/.config/wardos/theme/current, reload
#   wardos-theme next                the id after the current one in `list`, wrapping
#   wardos-theme install <git-url>   clone into ~/.local/share/wardos/themes/<name>, set it
#   wardos-theme remove <id>         delete an installed theme; shipped themes are refused
#   wardos-theme render [id]         render only (default: the current id), no reload
#   wardos-theme reload              signal the running components to re-read the render
#   wardos-theme bg next             the next file of the theme's backgrounds/, via swaybg
#                                    (and the lock screen, through the hyprlock fragment)
#
# Themes are searched in $WARDOS_THEMES (colon list), the user directory above,
# /usr/share/wardos/themes and $WARDOS_ROOT/themes. The render is done by
# wardos-theme-render (desktop/theme); this script only chooses and signals.
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wardos"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wardos"
user_themes="${XDG_DATA_HOME:-$HOME/.local/share}/wardos/themes"
current_dir="$config_dir/theme/current"
btop_themes="${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes"
default_theme="ward-dark"

die() { echo "wardos-theme: $*" >&2; exit 1; }

# Search directories, user first, in the renderer's order.
theme_dirs() {
  local d
  IFS=: read -r -a extra <<<"${WARDOS_THEMES:-}"
  for d in "${extra[@]}" "$user_themes" /usr/share/wardos/themes "${WARDOS_ROOT:+$WARDOS_ROOT/themes}"; do
    if [[ -n $d && -d $d ]]; then echo "$d"; fi
  done
}

# The directory holding <id>: its file is <dir>/<id>.toml, <dir>/<id>/<id>.toml
# or <dir>/<id>/theme.toml; its backgrounds are <dir>/<id>/backgrounds.
dir_of() {
  local id=$1 d
  while read -r d; do
    if [[ -f $d/$id.toml || -f $d/$id/$id.toml || -f $d/$id/theme.toml ]]; then
      echo "$d"
      return 0
    fi
  done < <(theme_dirs)
  return 1
}

list() {
  local d f
  while read -r d; do
    for f in "$d"/*.toml; do
      if [[ -f $f ]]; then basename "$f" .toml; fi
    done
    for f in "$d"/*/; do
      f=${f%/}
      if [[ -f $f/$(basename "$f").toml || -f $f/theme.toml ]]; then basename "$f"; fi
    done
  done < <(theme_dirs) | sort -u
}

current() {
  if [[ -s $current_dir/id ]]; then cat "$current_dir/id"; else echo "$default_theme"; fi
}

render() {
  local id=$1
  dir_of "$id" >/dev/null || die "no theme '$id' (see: wardos-theme list)"
  mkdir -p "$current_dir"
  wardos-theme-render "$id" --out "$current_dir"
  echo "$id" >"$current_dir/id"
}

# What the render says about itself, for the reload and the notification.
read_env() {
  WARDOS_THEME_NAME="" WARDOS_VARIANT="dark" WARDOS_GROUND="#0E0F11"
  # shellcheck source=/dev/null
  [[ -f $current_dir/colors.env ]] && source "$current_dir/colors.env"
  return 0
}

# swaybg has no reload: it is replaced. `background` is a path (the theme's own
# file, else the background.png the render draws from the tokens), or solid:<hex>
# when a hand-written file says so.
start_swaybg() {
  local bg
  command -v swaybg >/dev/null 2>&1 || return 0
  bg=$(cat "$current_dir/background" 2>/dev/null || echo "solid:$WARDOS_GROUND")
  pkill -x swaybg 2>/dev/null || true
  if [[ $bg == solid:* ]]; then
    (swaybg -c "${bg#solid:}" >/dev/null 2>&1 &)
  else
    (swaybg -i "$bg" -m fill >/dev/null 2>&1 &)
  fi
}

# Each running component re-reads the render its own way (docs/desktop.md §Themes):
# Hyprland and mako reload, Waybar takes SIGUSR2, Neovim SIGUSR1 (its init.lua
# re-applies nvim.lua), swaybg and swayosd are restarted (neither reloads), GNOME
# apps follow the colour scheme, btop only loads themes from its own directory so
# it gets a symlink, and Chromium reads chromium.json itself.
reload() {
  read_env
  command -v hyprctl >/dev/null 2>&1 && { hyprctl reload >/dev/null 2>&1 || true; }
  if command -v pkill >/dev/null 2>&1; then
    pkill -SIGUSR2 -x waybar 2>/dev/null || true
    pkill -SIGUSR1 -x nvim 2>/dev/null || true
  fi
  command -v makoctl >/dev/null 2>&1 && { makoctl reload 2>/dev/null || true; }
  start_swaybg
  command -v systemctl >/dev/null 2>&1 && { systemctl --user restart swayosd.service 2>/dev/null || true; }
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-$WARDOS_VARIANT" 2>/dev/null || true
  fi
  mkdir -p "$btop_themes"
  ln -sfn "$current_dir/btop.theme" "$btop_themes/wardos.theme"
  return 0
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a WardOS "$@"
}

set_theme() {
  local id=$1
  render "$id"
  reload
  read_env
  notify "Theme · ${WARDOS_THEME_NAME:-$id}"
}

next() {
  local cur ids first found=""
  cur=$(current)
  mapfile -t ids < <(list)
  [[ ${#ids[@]} -gt 0 ]] || die "no themes found"
  first=${ids[0]}
  for ((i = 0; i < ${#ids[@]}; i++)); do
    if [[ ${ids[i]} == "$cur" ]]; then
      found=${ids[i + 1]:-$first}
      break
    fi
  done
  set_theme "${found:-$first}"
}

# The clone's name: the last path element without .git, and without the
# wardos-theme-/wardos- prefix or -theme suffix a repository is likely to carry.
name_of_url() {
  local name
  name=$(basename "$1" .git)
  name=${name#wardos-theme-}
  name=${name#wardos-}
  name=${name%-theme}
  echo "$name"
}

install() {
  local url=$1 name dest
  name=$(name_of_url "$url")
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "cannot name a theme after '$url'"
  dest="$user_themes/$name"
  [[ -e $dest ]] && die "'$name' is already installed at $dest (remove it first)"
  mkdir -p "$user_themes"
  git clone --depth 1 "$url" "$dest"
  if [[ ! -f $dest/$name.toml && ! -f $dest/theme.toml ]]; then
    rm -rf "$dest"
    die "$url has no $name.toml or theme.toml; not a theme"
  fi
  set_theme "$name"
}

remove() {
  local id=$1
  if [[ -d $user_themes/$id ]]; then
    rm -rf "${user_themes:?}/$id"
  elif [[ -f $user_themes/$id.toml ]]; then
    rm -f "$user_themes/$id.toml"
  elif dir_of "$id" >/dev/null; then
    die "'$id' is shipped with WardOS; only themes under $user_themes can be removed"
  else
    die "no theme '$id'"
  fi
  [[ $(current) == "$id" ]] && set_theme "$default_theme"
  return 0
}

bg_next() {
  local id dir files state cur pick=""
  id=$(current)
  dir=$(dir_of "$id") || die "no theme '$id'"
  mapfile -t files < <(find "$dir/$id/backgrounds" -maxdepth 1 -type f 2>/dev/null | sort)
  [[ ${#files[@]} -gt 0 ]] || die "theme '$id' has no backgrounds ($dir/$id/backgrounds/)"
  state="$state_dir/background"
  cur=$(cat "$state" 2>/dev/null || true)
  for ((i = 0; i < ${#files[@]}; i++)); do
    if [[ ${files[i]} == "$cur" ]]; then
      pick=${files[i + 1]:-${files[0]}}
      break
    fi
  done
  pick=${pick:-${files[0]}}
  mkdir -p "$state_dir" "$current_dir"
  echo "$pick" >"$state"
  echo "$pick" >"$current_dir/background"
  point_lock_at "$pick"
  read_env
  start_swaybg
}

# The lock screen shows the wallpaper through the fragment's $wallpaper line
# (docs/desktop.md §Themes), so a cycled background reaches hyprlock too.
point_lock_at() {
  local pick=$1 esc
  [[ -f $current_dir/hyprlock.conf ]] || return 0
  esc=$(printf '%s' "$pick" | sed 's/[&|\\]/\\&/g')
  sed -i "s|^\\\$wallpaper .*|\$wallpaper  = $esc|" "$current_dir/hyprlock.conf"
}

verb=${1:-}
case $verb in
  list) list ;;
  current) current ;;
  set) [[ -n ${2:-} ]] || die "set needs an id"; set_theme "$2" ;;
  next) next ;;
  install) [[ -n ${2:-} ]] || die "install needs a git URL"; install "$2" ;;
  remove) [[ -n ${2:-} ]] || die "remove needs an id"; remove "$2" ;;
  render) render "${2:-$(current)}" ;;
  reload) reload ;;
  bg) [[ ${2:-} == next ]] || die "bg takes 'next'"; bg_next ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 1 ;;
esac
