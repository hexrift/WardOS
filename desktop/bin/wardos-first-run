#!/usr/bin/env bash
# wardos-first-run — the first login (docs/desktop.md §Commands).
#
# Usage: wardos-first-run [--force]
#
# Run by Hyprland's autostart. Once, unless --force (the marker is
# ~/.config/wardos/first-run-done): copies every default configuration into ~/.config
# (wardos-refresh --all), sets the Ward Dark theme, runs `ward doctor`, registers the
# shipped web and terminal apps as .desktop entries, shows the key bindings, runs
# wardos-calibrate (language, keyboard, timezone — CALIBRATE, ADR-0026), then hands over
# to wardos-welcome (theme, keys, first project, first agent). Tools that are not
# installed are skipped.
set -euo pipefail
# shellcheck source=desktop/lib/wardos.sh disable=SC1091
source "${WARDOS_LIB:-$(dirname "$(readlink -f "$0")")/../lib/wardos.sh}" 2>/dev/null ||
  source /usr/lib/wardos/wardos.sh
wardos_help "$@"

marker="$(wardos_config_dir)/first-run-done"
if [[ -e "$marker" && "${1:-}" != --force ]]; then exit 0; fi

# Record that first-run has happened BEFORE the best-effort steps below. They run
# under `set -e`, and if one exited non-zero after this point the script would abort
# with the marker unwritten — so the next login would run first-run again, re-copying
# the defaults and letting wardos-refresh's backup overwrite the user's real `.bak`
# (silent config-backup loss). Writing the marker first makes first-run idempotent
# regardless of any single step failing.
mkdir -p "$(dirname "$marker")"
date -u +%Y-%m-%dT%H:%M:%SZ >"$marker"

# Each step is best-effort: a failure is reported and skipped, never fatal, so the
# rest of onboarding (down to wardos-welcome) still runs.
wardos-refresh --all ||
  wardos_notify "Defaults not applied" "Run 'wardos-refresh --all' in a terminal"
# Adopt a first-boot provisioning keyboard choice (ADR-0027) into this user's Hyprland
# config: the provisioning broker set the system/console keymap, but wardos-refresh has just
# reset input.conf to the default layout, so re-apply the chosen one for the desktop itself.
kbstate="${WARDOS_KEYBOARD_STATE:-/var/lib/wardos/keyboard-layout}"
if [[ -s "$kbstate" ]] && wardos_has wardos-calibrate; then
  wardos-calibrate keyboard-local "$(head -n1 "$kbstate")" || true
fi
# -q: the desktop autostart already re-applies the theme on every login, so a first-run
# toast on top of it would be the duplicate "Theme · …" the reference laptop showed (E-09).
if wardos_has wardos-theme && ! wardos-theme set -q ward-dark; then
  wardos_notify "Theme not applied" "Run 'wardos-theme set ward-dark' in a terminal"
fi
# `ward doctor` cold-starts every shipped agent to read its version, so on slow media
# (a USB boot) it runs for tens of seconds — on the reference laptop the boot-time run
# took ~70s (E-09). It is purely informational here (the wardos-firstboot service writes
# the full report to /var/lib/wardos/doctor.txt regardless), so it must never hold up the
# rest of onboarding — the welcome, the keys, the walkthrough. Run it detached and only
# surface a notification if the host has real problems.
if wardos_has ward; then
  # Fully detached: redirect the whole subshell so it holds none of first-run's stdio
  # open (a background child keeping the exec-once's pipe open can itself read as a stall).
  (ward doctor >/dev/null 2>&1 ||
    wardos_notify "ward doctor found problems" "Run 'ward doctor' in a terminal") \
    </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
fi
wardos-webapp install --defaults ||
  wardos_notify "Web apps not registered" "Run 'wardos-webapp install --defaults' in a terminal"
wardos-tui install --defaults ||
  wardos_notify "Terminal apps not registered" "Run 'wardos-tui install --defaults' in a terminal"

wardos-keys
# The walkthrough (wardos-welcome, below) is the single sender of the "Welcome to WardOS"
# greeting — a second one here would be the duplicate toast the reference laptop showed
# (E-09), and it duplicated wardos-keys, which shows the keys on the next line anyway.
# CALIBRATE (ADR-0026): language, keyboard and timezone before the walkthrough, so the
# machine is usable in the user's own language and layout first. It keeps its own marker,
# is best-effort, and never blocks the walkthrough.
if wardos_has wardos-calibrate; then wardos-calibrate || true; fi
# The walkthrough keeps its own marker, so a login that skipped it can run it later.
if wardos_has wardos-welcome; then wardos-welcome; fi
