#!/usr/bin/env bash
# wardos-pause — pause or resume the agent session as one host operation
# (ADR-0019 §3, docs/desktop.md §Commands, docs/security-model.md G13).
#
# Usage:
#   wardos-pause            running: pause THIS session (processes frozen, network closed,
#                           credential grants suspended, approvals held), then offer the
#                           exits; already paused: offer the exits
#   wardos-pause pause      pause this session and offer the exits
#   wardos-pause resume     resume this session, no questions
#   wardos-pause menu       the exits: Resume / Stop & preserve workspace /
#                           Stop & restore entry state / Inspect activity
#   wardos-pause pause-all  pause every live session (#141 item 5: a distinct, explicit
#                           scope from pausing this one), one result line each
#   wardos-pause --status   print paused, running or none for this session (for the bar)
#   wardos-pause --help
#
# "This session" is WARDOS_SESSION's when set (an immutable, explicitly pinned id — a
# switcher or an approval panel's "pause this session" passes the id it is showing, so
# it can never be silently retargeted by another session starting or the desktop's
# selection changing meanwhile), else WARDOS_PROJECT's (default: the current directory,
# which for the bar and the keybind below is the desktop's selected session).
# Everything goes through `ward pause`, `ward resume`, `ward stop [--restore-entry]` and
# `ward watch`; the menu is wardos-menu-select (WARDOS_MENU_BACKEND=fuzzel|stdin). A
# cancelled menu changes nothing: a paused session stays paused until you say otherwise.
set -euo pipefail
# shellcheck source=desktop/lib/wardos.sh disable=SC1091
source "${WARDOS_LIB:-$(dirname "$(readlink -f "$0")")/../lib/wardos.sh}" 2>/dev/null ||
  source /usr/lib/wardos/wardos.sh
wardos_help "$@"

project=${WARDOS_PROJECT:-$PWD}
session_flag=()
[[ -n ${WARDOS_SESSION:-} ]] && session_flag=(--session "$WARDOS_SESSION")

# paused, running or none: the daemon's marker, read by `ward pause --status`.
# WARDOS_SESSION pins which session's state this reads, same as every other
# subcommand here (#141 finding 3: a no-argument toggle pinned to one session
# must never inspect a different one just because they disagree).
status() { ward pause --status "${session_flag[@]}" "$project" 2>/dev/null || echo none; }

# The one notification of a pause (ADR-0019 §3), critical so it stays until read.
# `ward pause` can legitimately end in an *unsettled* freeze (the marker is held and
# approvals stay suspended, but not every sandboxed process is confirmed stopped yet —
# `ward-daemon::pause::FREEZE_SETTLE`): #233's fix is to say so here rather than show
# the same "processes frozen" text either way, since this is the one notification most
# users actually see for a keybind-triggered pause with no terminal visible.
do_pause() {
  local out
  out=$(ward pause "${session_flag[@]}" "$project")
  # Captured to read the outcome below; still shown to a terminal user as before.
  [[ -n $out ]] && printf '%s\n' "$out"
  if [[ $out =~ ([0-9]+)\ process(es)?\ had\ not\ confirmed\ stopped ]]; then
    local pending=${BASH_REMATCH[1]} plural=""
    [[ $pending != 1 ]] && plural="es"
    wardos_notify "AGENTS PAUSING" \
      "network closed · credential grants suspended · $pending process$plural not yet confirmed stopped · workspace retained" \
      -u critical
  else
    wardos_notify "AGENTS PAUSED" \
      "network closed · credential grants suspended · processes frozen · workspace retained" \
      -u critical
  fi
}

do_resume() {
  ward resume "${session_flag[@]}" "$project"
  wardos_notify "Agents resumed" "" -t 2000
}

# "Pause all sessions" (#141 item 5): every live session, not just this one, each its own
# result line, so the notification is a per-session summary rather than one verdict.
# `ward pause --all` exits non-zero when any one session failed to pause (#141 finding 4):
# that status is carried into the title, so a partial failure is never announced as
# "ALL SESSIONS PAUSED" — the per-session lines already say which one, but the title is
# what a glance actually reads.
do_pause_all() {
  local out status=0
  out=$(ward pause --all --reason "${WARDOS_PAUSE_REASON:-host requested: pause all}") || status=$?
  if [[ $status -eq 0 ]]; then
    wardos_notify "ALL SESSIONS PAUSED" "$out" -u critical
  else
    wardos_notify "SOME SESSIONS NOT PAUSED" "$out" -u critical
  fi
}

# The exits of a pause. Cancelling is an answer too: everything stays held.
menu() {
  local choice
  choice=$(wardos_menu "Paused" "Resume" "Stop & preserve workspace" \
    "Stop & restore entry state" "Inspect activity") || return 0
  case "$choice" in
    Resume) do_resume ;;
    "Stop & preserve workspace")
      ward stop "$project"
      wardos_notify "Session stopped" "workspace kept as it is" -t 3000
      ;;
    "Stop & restore entry state")
      ward stop --restore-entry "$project"
      wardos_notify "Session stopped" "entry state restored · what it replaced is in .ward/restore-*" -t 4000
      ;;
    "Inspect activity") wardos_terminal_exec ward-observer ward watch "$project" ;;
  esac
}

case "${1:-}" in
  --status) status ;;
  pause)
    do_pause
    menu
    ;;
  resume) do_resume ;;
  menu) menu ;;
  pause-all) do_pause_all ;;
  "")
    case "$(status)" in
      running)
        do_pause
        menu
        ;;
      paused) menu ;;
      *) wardos_die "no agent session for $project (ward up)" ;;
    esac
    ;;
  *) wardos_die "pause, resume, menu, pause-all or --status? (--help)" ;;
esac
