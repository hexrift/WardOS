#!/usr/bin/env bash
# wardos-approve — answer an approval the session daemon holds
# (docs/design-language.md §10, ADR-0016, ADR-0019, docs/agent-integration.md §4.1).
#
# Usage:
#   wardos-approve                  pick a pending approval (one pending: it is picked),
#                                   show its three blocks, and answer from the keyboard:
#                                   y / s / n
#   wardos-approve <id> [y|s|n]     answer approval <id>: y allow once, s allow for the
#                                   session, n deny; without the answer, ask for it
#   wardos-approve --watch [--once] follow every live session's approvals (#141: not just
#                                   one project) and show each as a notification, titled
#                                   with the agent and the project it is asking for: DESTINATION
#                                   (sanitised by the daemon), REQUESTED BY AGENT (the agent's
#                                   words, labelled as such), WARD WILL ALLOW (network, method,
#                                   credential, repository, lifetime), then Allow once / Allow
#                                   session / Deny with their keys; the chosen action is relayed
#                                   to the daemon, on the socket of the session it asked from —
#                                   never the desktop's selected one, so switching the selection
#                                   while a notification is open cannot retarget it. A
#                                   notification still showing when its approval becomes
#                                   terminal some other way (answered from another terminal,
#                                   timed out, or the session ended with it open, #146 items
#                                   2-3) is replaced with the outcome and stops accepting an
#                                   action, rather than left offering one that no longer does
#                                   anything. Without --once the listener waits for the next
#                                   round of live sessions when they all end (this is what
#                                   wardos-approve.service runs). The decision time left is
#                                   mako's thin progress line (§10: not a number), refreshed
#                                   in place (notify-send --replace-id) every few seconds for
#                                   as long as the popup stays open (#146 item 4's live-refresh
#                                   half) from the daemon's own current figure, not frozen at
#                                   whatever it was when the popup opened; a question whose
#                                   session is paused says its clock is held instead, and holds
#                                   in place — visibly, not just silently stale — until resumed.
#                                   Two or more approvals that are exact duplicates — same session,
#                                   agent, project and authority (#146 item 7) — share one
#                                   notification, titled with a count (×N); answering it
#                                   answers every one of them and nothing broader.
#   wardos-approve --help
#
# The interactive path (no --watch) is reached through `ward session pending --json` and
# `ward session approve`, for WARDOS_SESSION's session when set (an immutable, explicitly
# pinned id — how the persistent inbox, wardos-approve-inbox, opens a pending approval
# belonging to a session other than WARDOS_PROJECT's/the desktop's selection, mirroring
# wardos-pause's own WARDOS_SESSION), else WARDOS_PROJECT's (default: the current
# directory; from home that is the desktop's selected session). Menus go through
# wardos-menu-select (WARDOS_MENU_BACKEND=fuzzel|stdin, WARDOS_MENU_CHOICE answers the
# stdin backend); when that command is absent the stdin backend is built in. Deny is the
# daemon's default on timeout, so an unanswered notification denies. The notification
# body is Pango markup: every value is escaped, so nothing the agent wrote can dress
# itself up as a row Ward derived, and the destination is in the mono face (<tt>,
# design-language §4).
#
# --watch bounds its live `notify-send --wait` workers at WARDOS_APPROVE_MAX_NOTIFIERS
# (10): past that, a new pending approval is left to the persistent inbox
# (wardos-approve-inbox) and `wardos-approve <id>` rather than adding another popup that
# might wait forever. Every worker it does start is cleaned up — the popup replaced or
# closed, the process reaped — the moment its approval is answered, times out, is
# answered elsewhere, or the session ends, so many approvals across many live sessions,
# or one the user is slow to act on, cannot pile up workers that outlive the answers they
# were waiting for, and one session's stale notification is never left blocking this
# listener from moving on to the next round of live sessions (#146 items 2-3). A missing
# or unreachable notification server never blocks or crashes this: a request that got no
# popup, or one whose popup nothing could show, is still fully answerable from
# `wardos-approve-inbox`, `wardos-approve <id>` or `ward session approve`. Needs jq.
set -euo pipefail

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

project=${WARDOS_PROJECT:-$PWD}
retry=${WARDOS_APPROVE_RETRY:-2}
max_notifiers=${WARDOS_APPROVE_MAX_NOTIFIERS:-10}
# The #146 item 7 coalescing window (below, notify_one): how long a new
# notification waits, at most, for an exact duplicate the main loop is still
# reading to join it before its count is fixed for the title. A `sleep` argument
# (seconds, fractional), not milliseconds, so tests can widen it past real
# scheduling jitter without an extra fork to do the arithmetic.
coalesce=${WARDOS_APPROVE_COALESCE_S:-0.05}
# How often an already-open notification refreshes in place (#146 item 4's
# live-refresh half, below: refresh_loop/refresh_apply): a `sleep` argument
# (seconds, fractional), not milliseconds, so a test can shrink it well below any
# real interaction time instead of racing real wall-clock cadence to see more
# than one tick.
refresh_interval=${WARDOS_APPROVE_REFRESH_S:-2}
# WARDOS_SESSION pins the interactive path to one session (mirroring wardos-pause):
# an immutable, explicitly given id — the persistent inbox's own way of opening a
# pending approval belonging to a session other than $project's/the desktop's
# selection — rather than $project's current session or "newest live".
session_flag=()
[[ -n ${WARDOS_SESSION:-} ]] && session_flag=(--session "$WARDOS_SESSION")

# One line per pending approval: id, session, agent, tool, the agent's claim, then
# what Ward derived: destination, network, method, credential, repository, lifetime,
# then the project it belongs to (#141: --watch multiplexes every live session), then
# the daemon's countdown for it (#146 item 4) as "run:<remaining_ms>:<timeout_ms>" or
# "held:<remaining_ms>:<timeout_ms>", or "-" when the daemon reports none (a daemon
# that predates it). Never empty: `read` with a tab IFS would collapse an empty field.
# The lifetime is unset while the question is open: the answer chooses it.
fields='[.id, .session, .agent, .tool, .claim,
         .authority.destination, .authority.network, .authority.method,
         .authority.credential, (.authority.repository // "none"),
         (.authority.lifetime // "once (y) · session (s)"), .project,
         (.countdown | if . == null then "-"
                       elif .held then "held:\(.remaining_ms):\(.timeout_ms)"
                       else "run:\(.remaining_ms):\(.timeout_ms)" end)] | @tsv'

# One line per approval `ward session approvals --json --follow` reports (#146 items
# 2-3): id, its state word (mirroring ApprovalRecord::state_word — pending, allowed,
# allowed-session, denied, timed-out or session-ended), and the destination, for
# --watch's per-session resolver to tell which still-showing notification, if any, to
# update.
approvals_fields='
  def state_word:
    if .outcome == null then "pending"
    elif (.outcome | type) == "string" then
      if .outcome == "timed-out" then "timed-out"
      elif .outcome == "closed" then "session-ended"
      elif .outcome == "remembered" then "allowed-session"
      else .outcome
      end
    elif .outcome.answered == "allow" then "allowed"
    elif .outcome.answered == "allow-session" then "allowed-session"
    else "denied"
    end;
  [.approval.id, state_word, .approval.authority.destination] | @tsv'

# The words the design uses for the three answers.
decision_of() {
  case $1 in
    y|allow) echo allow ;;
    s|session|allow-session) echo allow-session ;;
    n|deny) echo deny ;;
    *) echo "wardos-approve: unknown answer '$1' (y, s or n)" >&2; return 1 ;;
  esac
}

# The daemon's countdown (a `fields` countdown column) in words, for the terminal,
# mirroring Countdown::text: whole seconds, rounded up. Nothing for "-". Only ever the
# daemon's own figure — nothing here derives a deadline from when a request arrived.
decision_words() {
  local countdown=$1 kind rest remaining secs
  [[ $countdown == run:* || $countdown == held:* ]] || return 0
  kind=${countdown%%:*} rest=${countdown#*:}
  remaining=${rest%%:*}
  secs=$(((remaining + 999) / 1000))
  if [[ $kind == held ]]; then
    printf 'held while paused · %s s left once resumed' "$secs"
  else
    printf '%s s left, then denied' "$secs"
  fi
}

# The same countdown as mako's progress line (§10: a thin line, not a number): the
# share of decision time left, in percent, rounded up so a question with any time left
# never shows an empty line. Nothing for "-" or a zero timeout.
progress_value() {
  local countdown=$1 rest remaining timeout
  [[ $countdown == run:* || $countdown == held:* ]] || return 0
  rest=${countdown#*:}
  remaining=${rest%%:*} timeout=${rest#*:}
  ((timeout > 0)) || return 0
  printf '%s' $(((remaining * 100 + timeout - 1) / timeout))
}

# Pick one line from stdin: wardos-menu-select when it exists, else the stdin
# backend (the line whose first field, or whole text, is WARDOS_MENU_CHOICE).
select_line() {
  local prompt=$1
  if command -v wardos-menu-select >/dev/null 2>&1; then
    wardos-menu-select --prompt "$prompt"
    return
  fi
  local choice=${WARDOS_MENU_CHOICE:-} line
  [[ -n $choice ]] || return 1
  while IFS= read -r line; do
    if [[ $line == "$choice" || ${line%%$'\t'*} == "$choice" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done
  return 1
}

answer() {
  local id=$1 session=$2 decision=$3
  ward session approve --session "$session" "$id" "$decision"
}

# Escape Pango markup, so text cannot pose as markup of its own.
esc() {
  local s=$1
  s=${s//&/\&amp;}
  s=${s//</\&lt;}
  s=${s//>/\&gt;}
  printf '%s' "$s"
}

# The three blocks of §10 from the fields of one approval. Markup (1) is the
# notification: dim headers, the destination in <tt>, everything escaped. Plain (0)
# is the terminal: the same blocks, indented. An optional ninth argument is the
# decision time (#146 item 4) in words, shown as a DECISION TIME block after them.
blocks() {
  local markup=$1 claim=$2 destination=$3 network=$4 method=$5 credential=$6 repository=$7 lifetime=$8
  local decision=${9:-}
  local h1=DESTINATION h2='REQUESTED BY AGENT' h3='WARD WILL ALLOW' h4='DECISION TIME' pad='  ' target
  if [[ $markup == 1 ]]; then
    h1="<span alpha=\"39322\">$h1</span>"
    h2="<span alpha=\"39322\">$h2</span>"
    h3="<span alpha=\"39322\">$h3</span>"
    h4="<span alpha=\"39322\">$h4</span>"
    pad=''
    target="<tt>$(esc "$destination")</tt>"
    claim=$(esc "$claim") network=$(esc "$network") method=$(esc "$method")
    credential=$(esc "$credential") repository=$(esc "$repository") lifetime=$(esc "$lifetime")
    decision=$(esc "$decision")
  else
    target=$destination
  fi
  printf '%s\n%s%s\n\n%s\n%s%s\n\n%s\n' "$h1" "$pad" "$target" "$h2" "$pad" "$claim" "$h3"
  printf "${pad}%-12s %s\n" Network "$network" Method "$method" Credential "$credential" \
    Repository "$repository" Lifetime "$lifetime"
  [[ -n $decision ]] && printf '\n%s\n%s%s\n' "$h4" "$pad" "$decision"
  return 0
}

# Ask for the answer with the menu: y / s / n.
ask_decision() {
  local chosen
  chosen=$(printf 'y\tAllow once\ns\tAllow session\nn\tDeny\n' | select_line "Approve") || return 1
  decision_of "${chosen%%$'\t'*}"
}

# The interactive path: list what is pending, pick one, show it, answer it.
interactive() {
  local id=${1:-} given=${2:-} pending chosen session decision
  pending=$(ward session pending --json "${session_flag[@]}" "$project" | jq -r "$fields")
  if [[ -z $pending ]]; then
    echo "  no pending approvals"
    return 0
  fi
  if [[ -n $id ]]; then
    chosen=$(printf '%s\n' "$pending" | awk -F'\t' -v id="$id" '$1 == id') || true
    [[ -n $chosen ]] || { echo "wardos-approve: approval $id is not pending" >&2; return 1; }
  elif [[ $(printf '%s\n' "$pending" | wc -l) -eq 1 ]]; then
    chosen=$pending
  else
    chosen=$(printf '%s\n' "$pending" \
      | awk -F'\t' '{ printf "%s\t%s · %s %s\n", $1, $3, $4, $6 }' \
      | select_line "Approval") || return 1
    chosen=$(printf '%s\n' "$pending" | awk -F'\t' -v id="${chosen%%$'\t'*}" '$1 == id')
  fi
  id=${chosen%%$'\t'*}
  session=$(printf '%s\n' "$chosen" | cut -f2)
  if [[ -n $given ]]; then
    decision=$(decision_of "$given")
  else
    local agent tool claim destination network method credential repository lifetime countdown
    IFS=$'\t' read -r _ _ agent tool claim destination network method credential repository lifetime _ \
      countdown <<<"$chosen"
    printf '%s requests · %s\n' "${agent^}" "$tool"
    blocks 0 "$claim" "$destination" "$network" "$method" "$credential" "$repository" "$lifetime" \
      "$(decision_words "$countdown")"
    decision=$(ask_decision) || return 1
  fi
  answer "$id" "$session" "$decision"
}

# --- --watch: notification lifecycle (#146 items 2-3) --------------------------
#
# run_dir, set by follow_once for this round of live sessions, holds up to four
# files per notification still showing or still relaying its answer (one
# notification may be answering for more than one approval id at once, #146 item
# 7): a pid file the pid of the notify-send process showing it, a matching .out
# file that process's stdout — the notification's own id, as soon as the server
# assigns one (`--print-id`), then the chosen action once it closes — a .worker
# file the pid of notify_one's own background job, and a .answer file the pid of
# the `ward session approve` call(s) it makes at the very end. All four are named
# from gkey (see below, by the .ids/.current paragraph): two live sessions can
# legitimately hold a pending approval with the same numeric Approval::id at once
# (#222 review — it is only that *session's* sequence number, not a global one),
# and two overlapping generations of the very same key can legitimately exist at
# once too (#228 review) — keying these files from anything less specific than
# gkey would let one overwrite another's still-live files.
#
# .pid and .out are removed the moment nothing more needs them, so "a *.pid file
# exists for this key" is exactly "a notification for it is still showing"; that is
# what bounds active_notifiers and what a resolve elsewhere below checks before it
# acts, so it never touches a notification that already closed on its own.
#
# .worker outlives .pid — notify_one still has to read .out, decide, and relay the
# answer with `ward session approve` after the notify-send process behind .pid has
# already exited — and is what wait_for_notifiers below actually waits on for the
# ordinary case (#224: waiting on .pid's notify-send process alone let notify_one's
# own tail end race follow_once returning and outlive it as an orphan). It is
# reserved empty by notifier_loop, like .pid, before notify_one starts, but *filled
# in by notify_one itself* with its own $BASHPID as its very first action, not by
# notifier_loop after backgrounding it: notifier_loop backgrounding notify_one and
# then writing $! is a second process racing notify_one's own RETURN trap, which
# can remove the file first (an instant return — notify-send missing, say) and
# leave notifier_loop to recreate it moments later holding a pid that has already
# exited and will now never be cleaned up by anything but sweep_run_dir (#226
# review: reproduced independently, 10 stale markers in 10,000 runs). Writing it
# from inside notify_one keeps the write and its own later removal strictly
# ordered, the same way .pid's real value is filled in by notify_one itself rather
# than by notifier_loop.
#
# .answer holds the pid of the `ward session approve` call notify_one backgrounds
# for exactly this reason — wait_for_notifiers' own bound is a grace period, not a
# guarantee, so a `ward` call slow enough to still be running once it lapses would
# otherwise be exactly the same orphan again, one layer in (#226 review). Past the
# grace period, a worker is no longer given the benefit of the doubt: sweep_run_dir
# stops it directly, and does not merely signal it and hope — a killed pid
# routinely still answers `kill -0` immediately afterwards, so a bare `kill`
# proves nothing (#226 review) — it gives it a bounded grace to exit on its own,
# escalates to KILL if that lapses, then actually joins it (`wait`) before
# run_dir is removed below. It never signals the answer call directly for this,
# though: that call is this shell's *grandchild*, reached only through the
# worker, so this could only ever signal it, never actually join it, and doing
# that as an operation of its own — independent of, and before, stopping the
# worker itself — is exactly how an already-killed answer call can still outlive
# a worker simply terminated out from under it before its own reap of that
# answer call had completed (#226 review, again). notify_one's own TERM trap is
# what reaps its answer call, if it has one in flight, before it can itself die
# from being signalled this way — the worker is its real parent, the only thing
# that can wait() on it, so it has to be the one to do this, not sweep_run_dir.
#
# A fifth, .ids, holds the id (or ids: #146 item 7 folds exact duplicates into one
# notification, so more than one line is the common case for it, not an edge case)
# a given notification is currently answering for; a sixth, per id, an
# "id-<session, id>.group" marker naming which notification (if any) that id was
# folded into, for resolve_notification to find and update without scanning every
# group's .ids file.
#
# .pid, .out, .worker, .answer and .ids are all named from gkey, not from the bare
# group_key (a hash of the exact title and body notify_one renders, unique to a
# byte-identical ask in one session, same as before #228) — gkey is group_key with
# a further ".gen.<gen>" suffix, minted fresh by open_new_generation every time a
# key with no currently-open generation gets a new one. A key's generations never
# share a filename, however their lifetimes happen to overlap: the review on #228
# found two real designs here still broken this way. The first (.ids, a single
# file notifier_loop appended to, notify_one read-then-truncated, and
# resolve_notification read-filtered-rewrote) let a concurrent append and removal
# lose one or the other, and let a duplicate arriving in the gap between
# notify-send exiting (releasing .pid) and notify_one actually consuming .ids
# start a second generation under the same key, corrupting the first's
# bookkeeping out from under it. The second, round-1 fix (per-id "id-*.group"
# markers as the sole membership record, .worker instead of .pid as the "still
# live" signal, sweep_group_markers cleaning up whatever a RETURN trap's own
# answer loop did not) closed that specific .pid/.worker gap, but the closing
# itself — .worker removed, then sweep_group_markers scanning and deleting every
# marker still naming key — was two separate, unsynchronised steps: a new
# generation could open (see .worker gone, reserve key afresh, write a fresh
# marker) in the instant between them, and the old generation's own sweep, still
# running, could delete that brand new marker right back out, because it too
# named key — no lock anywhere made "is a generation for key still accepting
# members" and "record this id as one of them" atomic with each other, on any
# actor's side.
#
# key.current holds the gen of the one generation, if any, still open to a new id
# joining it — cleared by notify_one the instant it snapshots that generation's ids
# (see notify_one), which is also the instant a same-key request that arrives after
# must start a fresh generation of its own rather than being folded into one that
# has already fixed its membership. Every read-and-maybe-mutate of key.current or a
# generation's .ids file — here, in notify_one's close-out, in resolve_notification,
# and in a refresh tick's own group_representative_id (#250 review, third round: an
# unlocked read raced resolve_notification's own rewrite) — holds key.lock for the
# whole operation, so an append (this loop), a snapshot-and-clear (notify_one), a
# remove (resolve_notification) and a plain read (group_representative_id) can
# never interleave and lose or tear one another's view of it. Both key.current and
# key.lock live for as long as run_dir does, same as everything else here.
#
# It also holds one "session-<key>.resolver" marker per live session that has (or
# had) an open notification, holding that session's own resolver's pid.
#
# Three more, per gkey, are #146 item 4's live-refresh half: a ".blockargs" file —
# notifier_loop's own raw (pre-escape) block fields for this generation's request,
# written once, alongside .pid/.worker, when the generation opens, so a refresh
# tick can re-render the DECISION TIME block and progress hint from a *fresh*
# countdown without notify_one's own signature having to carry those fields through
# every one of its own callers, traps and tests just for this — a ".refresh" file,
# reserved empty the same way and for the same reason .worker is (notify_one's own
# comment on it), holding the refresh loop's own pid, filled in by that loop itself
# as its first action so sweep_run_dir can find and stop it directly if notify_one
# itself ever has to be force-killed past its own TERM trap's chance to do so — and
# a ".notiflock" file, an empty file whose only job is the flock with_notiflock
# takes on it: the single, dedicated critical section a refresh tick and
# finish_notification's own terminal replace both run inside, so whichever of them
# checks pid_file and acts on it *second* always sees the other's result. Never
# key.lock for that: key.lock only ever guards *group membership* (ids/current),
# shared across every generation of a key, and reusing it for a notification's own
# content would give an unrelated generation's refresh tick contention with this
# one, and complicate finish_notification's own already-carefully-ordered calls
# into it, for no benefit — a refresh tick has no business touching membership at
# all, only showing an accurate countdown for whichever ids are gathered under it
# right now.
run_dir=""

# A short, fixed-shape, filesystem-safe stand-in for an opaque session id
# (ward_policy::SessionId is an untyped string — nothing here assumes it is
# ASCII, alnum, or free of "/"), the same way wardos-launch keys a cache entry
# off a hash of a path rather than a sanitised copy of the path itself.
session_key() {
  printf '%s' "$1" | sha256sum | cut -c1-16
}

# The composite identity a notification's files are named from: session_key is
# always exactly 16 lowercase hex chars, so "__" can never appear inside it,
# which makes it an unambiguous separator from id (always digits — Approval::id
# is a plain sequence number) even though nothing here needs to split it back
# apart again.
notif_key() {
  printf '%s__%s' "$(session_key "$1")" "$2"
}

# The identity a *notification* is shown under (#146 item 7): a hash of the exact
# title and body notify_one would render, so two pending approvals fold into the
# same popup only when they are byte-identical — same session, same agent, same
# project, same claim, and the same authority the daemon derived (destination,
# network, method, credential, repository, lifetime; the DECISION TIME wording
# folded in too, so a held one is never merged with a running one). Deliberately
# excludes the progress hint (§10: a snapshot that can differ by milliseconds
# between two otherwise-identical requests) and the id itself. A person answering a
# grouped notification cannot tell it apart from a single one asking the same
# thing, because it is: one action then answers every id gathered under this key
# and nothing else — never a broader grant than what is shown (see notify_one).
group_key() {
  local session=$1 title=$2 body=$3 content
  content=$(printf '%s\n%s' "$title" "$body" | sha256sum | cut -c1-16)
  printf '%s__%s' "$(session_key "$session")" "$content"
}

active_notifiers() {
  # A glob that matches nothing expands to itself; -f screens that out.
  local n=0 f
  for f in "$run_dir"/*.pid; do [[ -f $f ]] && ((++n)); done
  printf '%s\n' "$n"
}

# --- group membership: one live *generation* per key, never reused -----------------
#
# group_key alone is not enough to name a live generation's files (#228 review): a
# key's notification can be answered and its worker can still be relaying decisions
# well after the popup itself is gone, and a later, unrelated request that happens to
# hash to the same key must never be folded into, or overwrite the still-in-flight
# bookkeeping of, that finished-but-not-yet-reaped generation. Every generation this
# loop opens for a key therefore gets its own unique suffix (gen: wall-clock
# nanoseconds, this process's pid and $RANDOM — collision-free within one run_dir's
# lifetime), and every one of its files is named from the composite gkey =
# "key.gen.<gen>", never from key alone — so two generations of the same key can
# never collide on a filename, however their lifetimes overlap, and there is no
# shared, cross-generation state (a sweep, a single .worker) for two actors to race
# transitioning at once.
#
# Bash's "exec {fd}>file" inside a command substitution only ever affects that
# substitution's own subshell, and the flock it holds is released the moment that
# subshell exits — there is deliberately no matching "exec {fd}>&-" below.

# id (session's own) joins key's currently-open generation, if it has one: writes
# id's own "id-<session, id>.group" marker naming that gkey under the very same lock
# hold as the ids append, so a resolver checking for the marker right after this can
# never observe the append without it (#228 review, round 2 — publishing the marker
# only after releasing the lock left exactly that gap: a terminal event for id
# delivered in it found no marker, returned having done nothing, and this generation
# went on to answer an id that was already decided elsewhere). Echoes the gkey
# joined ("key.gen.<gen>"), or nothing if key has no open generation right now (the
# caller must then open one itself, via open_new_generation).
join_open_generation() {
  local key=$1 id=$2 session=$3 lk cur marker
  marker=$run_dir/id-$(notif_key "$session" "$id").group
  exec {lk}>"$run_dir/$key.lock"
  flock -x "$lk"
  cur=$(cat "$run_dir/$key.current" 2>/dev/null || true)
  if [[ -n $cur ]]; then
    printf '%s\n' "$id" >>"$run_dir/$key.gen.$cur.ids"
    printf '%s\n' "$key.gen.$cur" >"$marker"
    printf '%s\n' "$key.gen.$cur"
  fi
}

# Open a brand new generation for key, seeded with id as its first (only) member,
# make it key's current one, and publish id's own marker — all under the same lock,
# for the same reason join_open_generation does (#228 review, round 2). Always
# echoes the gkey id ends up in: ordinarily a freshly minted one, but if key somehow
# already has a current generation by the time this actually takes the lock —
# nothing here can cause that (notifier_loop is this script's only opener, and it
# calls this at most once per pending line, never concurrently with itself) — id
# joins that one instead rather than this leaking a second live generation for the
# same key.
open_new_generation() {
  local key=$1 id=$2 session=$3 lk cur gen marker
  marker=$run_dir/id-$(notif_key "$session" "$id").group
  gen=$(date +%s%N)-$$-$RANDOM
  exec {lk}>"$run_dir/$key.lock"
  flock -x "$lk"
  cur=$(cat "$run_dir/$key.current" 2>/dev/null || true)
  if [[ -n $cur ]]; then
    printf '%s\n' "$id" >>"$run_dir/$key.gen.$cur.ids"
    printf '%s\n' "$key.gen.$cur" >"$marker"
    printf '%s\n' "$key.gen.$cur"
  else
    printf '%s\n' "$gen" >"$run_dir/$key.current"
    printf '%s\n' "$id" >"$run_dir/$key.gen.$gen.ids"
    printf '%s\n' "$key.gen.$gen" >"$marker"
    printf '%s\n' "$key.gen.$gen"
  fi
}

# gkey (of key) is done reading its own membership — notify-send returned, or was
# never available at all: echo whichever ids are in gkey's .ids file at the instant
# this takes key.lock, remove that file, and — only if key.current still names this
# exact generation, never unconditionally — clear it, so a request arriving after
# this point starts a new generation of its own rather than joining one that has
# already fixed its membership (#228 review) or silently missing one that joined in
# the last instant before this locked (the append and this run under the same lock,
# so neither can happen "half-way" through the other).
close_generation() {
  local key=$1 gkey=$2 lk gen cur
  gen=${gkey##*.gen.}
  exec {lk}>"$run_dir/$key.lock"
  flock -x "$lk"
  cat "$run_dir/$gkey.ids" 2>/dev/null || true
  rm -f "$run_dir/$gkey.ids"
  cur=$(cat "$run_dir/$key.current" 2>/dev/null || true)
  [[ $cur == "$gen" ]] && rm -f "$run_dir/$key.current"
}

# One notification, waited on; the action chosen is the answer, relayed to every id
# gathered under key by the time this reads it (group_key: exact duplicates of the
# same session, agent, project, claim and authority, #146 item 7) — never re-resolved
# from the desktop's current selection, and never any id outside the group, however
# similar (never a broader grant than what is shown). Runs in the background (from
# follow_once's notifier loop, which has already reserved key's place against
# max_notifiers by creating its pid and worker files, and written id's own group
# marker, before this starts) so a second approval — from this session or another
# live one, even one sharing the same numeric id, or an exact duplicate that joins
# this same group — is not queued behind the first. notify-send absent is not an
# error: nothing is shown or tracked and nothing is answered from here, but every
# gathered approval is still open to wardos-approve-inbox, `wardos-approve <id>`
# and `ward session approve` — the reservation is released so it does not count
# against the bound forever.
notify_one() {
  local session=$1 gkey=$2 agent=$3 project=$4 body=$5 progress=${6:-}
  local key=${gkey%.gen.*}
  local pid_file=$run_dir/$gkey.pid worker_file=$run_dir/$gkey.worker \
    answer_file=$run_dir/$gkey.answer ids_file=$run_dir/$gkey.ids hint=()
  local answer_pids=()
  # This worker's own refresh_loop pid (#146 item 4's live-refresh half, below),
  # empty until (and unless) one is actually started. Declared here, before either
  # trap below, so both can safely test it even on a return path that fires before
  # a refresh loop is ever started (notify-send missing, say).
  local refresh_pid="" refresh_spawning=0
  # Remove both markers on every return path (notify-send missing, no action, an
  # unrecognised action, or a relayed answer) so wait_for_notifiers' wait, and
  # sweep_run_dir's own force-stop, never outlast this function actually finishing
  # (#224, #226 review). A refresh loop still running at that point is stopped
  # here too, defence in depth alongside the explicit stop below (once notify-send
  # itself is done) — every return path this function has must leave nothing of
  # its own behind, not only the ordinary one.
  trap '
    rm -f "$worker_file" "$answer_file"
    if [[ -n $refresh_pid ]]; then
      kill "$refresh_pid" 2>/dev/null
      wait "$refresh_pid" 2>/dev/null
    fi
  ' RETURN
  # sweep_run_dir may have to stop this worker directly, past its own grace
  # period — but only ever by signalling *this*, never an answer call directly:
  # this is every one of those calls' real parent, the only thing that can wait()
  # on them, so this reaps whichever are still in flight before dying itself.
  # Terminating the worker without that would just relocate the exact orphan #224
  # was one process up — an already-killed answer call that nothing ever reaps
  # (#226 review). Bounded the same way sweep_run_dir's own escalation is; one id's
  # answer taking the grace window does not cost the others their own turn at it,
  # since the signal to every one of them goes out first, in one pass. The refresh
  # loop, if one is running, is stopped first and separately — it answers nothing
  # and has no grace window of its own to bound, so there is nothing to gain by
  # folding it into the answer_pids loop below.
  trap '
    if [[ -z $refresh_pid && $refresh_spawning -eq 1 ]]; then
      refresh_pid=$!
    fi
    if [[ -n $refresh_pid ]]; then
      kill "$refresh_pid" 2>/dev/null || true
      wait_deadline "$refresh_pid" 1
      if kill -0 "$refresh_pid" 2>/dev/null; then
        kill -KILL "$refresh_pid" 2>/dev/null || true
      fi
      wait "$refresh_pid" 2>/dev/null || true
    fi
    local p
    for p in "${answer_pids[@]:-}"; do
      [[ -n $p ]] && kill "$p" 2>/dev/null
    done
    for p in "${answer_pids[@]:-}"; do
      [[ -n $p ]] || continue
      wait_deadline "$p" 1
      if kill -0 "$p" 2>/dev/null; then
        kill -KILL "$p" 2>/dev/null || true
      fi
      wait "$p" 2>/dev/null || true
    done
    exit 143
  ' TERM
  # notifier_loop already reserved $worker_file, empty, before backgrounding this;
  # filling in the real value here, as this job's own very first action, keeps the
  # write strictly ordered before this same function's later removal of it above —
  # notifier_loop writing $! itself, after backgrounding, would instead be a second
  # process racing this trap, which can fire (an instant return below) before that
  # write ever lands (#226 review). $BASHPID, not $$, which stays the top-level
  # shell's pid even inside a backgrounded function call.
  printf '%s\n' "$BASHPID" >"$worker_file"
  # A brief coalescing window before this group's count is read (#146 item 7): id was
  # only just reserved by notifier_loop's own synchronous write, backgrounding this
  # function immediately after — an exact duplicate the daemon reports a moment later,
  # from the very same batch an agent fired at once, is still being read and folded
  # into ids_file by that same loop, racing this one rather than following it. This
  # gives that race a fair, bounded chance to settle in the group's favour before the
  # count is fixed for the title, without meaningfully delaying the notification
  # itself. A duplicate that still arrives after this cannot retroactively grow the
  # title — the same snapshot semantics design-language.md §10 already gives the
  # decision-time figure — but is still answered along with the rest (notify_one
  # re-reads ids_file after the answer, not this count). Configurable
  # (WARDOS_APPROVE_COALESCE_S) so a test asserting an exact count can widen it well
  # past real scheduling jitter instead of chasing a race against the main loop's
  # own timing.
  sleep "$coalesce"
  # Counted with a builtin `read` loop, not `wc -l` (a fork and an exec of an
  # external binary): every extra process this function forks before pid_file holds
  # notify-send's real pid widens the exact race #224/#226 fixed by joining .worker
  # instead of .pid — harmless now that wait_for_notifiers waits on .worker, but
  # still needless latency on the common, non-grouped path.
  local count=0 title _line
  while IFS= read -r _line; do ((++count)); done <"$ids_file" 2>/dev/null || true
  ((count > 0)) || count=1
  title="${agent^} requests · ${project}"
  ((count > 1)) && title="$title (×$count)"
  # The decision time left, as mako's progress line (#146 item 4): the standard
  # `value` hint, from the daemon's own countdown as this popup opens.
  [[ -n $progress ]] && hint=(-h "int:value:$progress")
  if ! command -v notify-send >/dev/null 2>&1; then
    rm -f "$pid_file"
    close_generation "$key" "$gkey" >/dev/null
    return 0
  fi
  local out=$run_dir/$gkey.out action decision ns_pid ids
  : >"$out"
  # Backgrounded directly, not inside a `{ ...; }` group: $! must be notify-send's
  # own pid, not a wrapper subshell's, so a resolve elsewhere's kill (below) reaches
  # the process actually holding the notification open, not a shell that already
  # has nothing left to do and exits on its own regardless of the kill.
  notify-send -a WardOS -c ward-approval -u critical --wait --print-id "${hint[@]}" \
    -A allow="Allow once" -A session="Allow session" -A deny="Deny" \
    "$title" "$body" >"$out" 2>/dev/null &
  ns_pid=$!
  printf '%s\n' "$ns_pid" >"$pid_file"
  # #146 item 4's live-refresh half: notifier_loop wrote this generation's raw
  # (pre-escape) block fields once, when it opened, precisely so this does not
  # have to widen its own signature (and every caller's, trap's and test's
  # understanding of it) just to carry them through to a loop that only exists to
  # re-render the DECISION TIME block and hint from a fresh countdown later.
  # Absent (an older run_dir layout, or the generation somehow never got one) or
  # short a field is simply no live refresh for this popup — the same graceful
  # fallback as notify-send itself being absent, never an error.
  local blockargs_file=$run_dir/$gkey.blockargs
  # Declared here, unconditionally, so it is always a defined (if empty) array
  # under `set -u` — including on the no-live-refresh fallback below, and later
  # when the self-decided/timed-out cleanup reads _blockargs[1] (destination) for
  # its own terminal replacement (#250 review).
  local -a _blockargs=()
  if [[ -f $blockargs_file ]]; then
    # A builtin `read` loop, not `mapfile`/`readarray`, matching this script's own
    # established preference (see notify_one's own count, above) for one fewer
    # thing to depend on being available.
    local _blockarg
    while IFS= read -r _blockarg; do _blockargs+=("$_blockarg"); done <"$blockargs_file"
    if [[ ${#_blockargs[@]} -eq 7 ]]; then
      # Reserved empty here, before backgrounding, the same way .worker/.pid
      # already are — not left for the loop itself to create as its own first
      # action (#250 review: the run_dir comment above already claims this
      # ordering; the code did not actually do it, leaving a window between
      # `&` and refresh_loop's own first write in which sweep_run_dir's
      # "$run_dir"/*.refresh glob cannot find it at all, not even as an empty,
      # not-yet-real marker the way stop_refresh already tolerates for every
      # other case). refresh_loop still fills in its own real pid as its first
      # action; stop_refresh's existing empty-pid handling covers the gap
      # between the two.
      : >"$run_dir/$gkey.refresh"
      refresh_spawning=1
      refresh_loop "$session" "$gkey" "$pid_file" "$out" "$title" "${_blockargs[@]}" &
      refresh_pid=$!
      refresh_spawning=0
    fi
  fi
  wait "$ns_pid" 2>/dev/null || true
  # Stopped and reaped here, explicitly, not left to the RETURN/TERM traps
  # alone. Killing/waiting $refresh_pid only reaches refresh_loop's own driver
  # process, never a tick that has already entered with_notiflock and is
  # synchronously running its own notify-send -r inside the lock (#250
  # review): that tick is an orphan the driver's death cannot reach, free to
  # land its now-stale redraw right after. The locked terminal step below,
  # requested only once this has actually finished, does not reach into that
  # already in-flight call either, but it does make every check-then-act
  # against pid_file race-free from here on: whichever of this and a tick's
  # own lock hold runs first, the other sees its result. At most the one tick
  # already in-flight when notify-send returns can still land a single stale
  # redraw; a later tick's own `[[ -f $pid_file ]]` check, now inside the same
  # lock, finds it gone and refresh_loop stops itself before ever trying.
  if [[ -n $refresh_pid ]]; then
    kill "$refresh_pid" 2>/dev/null || true
    wait "$refresh_pid" 2>/dev/null || true
    refresh_pid=""
  fi
  action=$(tail -n1 "$out" 2>/dev/null || true)
  # The state word this popup's own answer resolves to, if it resolves to one
  # at all. Only decides *what to relay*, below — never, on its own, what the
  # notification is finally replaced with (#250 review, third round: writing
  # "Allowed"/"Denied" right here, before `ward session approve` has even been
  # asked, let a paused/expired approval, an unreachable daemon, or a partial
  # failure in a grouped notification leave the UI claiming a decision the
  # daemon never actually recorded, with no tracked popup left for the
  # resolver to ever correct). Empty for anything decision_of does not
  # recognise (a timeout or a dismissed popup): nothing to relay, and
  # notify-send itself already closed the notification in that case — but
  # this popup can still have a redraw in flight, so it still gets its own
  # locked terminal step below, never left to the resolver alone.
  local state=""
  if [[ -n $action ]]; then
    case $(decision_of "$action" 2>/dev/null || true) in
      allow) state=allowed ;;
      allow-session) state=allowed-session ;;
      deny) state=denied ;;
    esac
  fi
  # Whichever ids are still in the group now: one may have been answered from
  # another terminal, the inbox, or timed out while this was open (resolve_notification
  # removes it from ids_file as that happens) — never relayed to twice, and never to
  # one that was never part of this group. close_generation takes key.lock for the
  # whole snapshot-and-clear, so this can never lose an id notifier_loop is
  # concurrently folding in, or race resolve_notification's own removal (#228
  # review), and it is the instant key becomes free to open a fresh generation of
  # its own — gkey's own files are never reused, only key's *next* gen may now start.
  ids=$(close_generation "$key" "$gkey")
  if [[ -n $state && -z $ids ]]; then
    # Every member was already removed by the daemon-backed resolver. Zero relay
    # attempts are not confirmation of this popup's locally clicked action.
    # Leave pid_file/out_file intact so that resolver's authoritative terminal
    # record owns the final replacement instead of publishing a guessed Allowed/
    # Denied state here.
    return 0
  fi
  if [[ -z $state ]]; then
    # Nothing recognised to relay. pid_file is retired here, not left for the
    # daemon's own eventual terminal record: a popup dismissed (or timed out)
    # without the daemon itself ever hearing from this worker again can sit
    # unresolved for a long time otherwise, stale content and all.
    with_notiflock "$gkey" finish_notification_self_decided_locked \
      "$pid_file" "$out" "closed" "${_blockargs[1]:-}"
    rm -f "$out"
    return 0
  fi
  decision=$(decision_of "$action")
  # Each backgrounded directly, the same reason and the same way as notify-send
  # above (a wrapper subshell's pid would not be the one actually still running if
  # the TERM trap above needs to stop it), rather than going through the shared
  # `answer` helper the interactive path uses as-is. Every pid is on disk before any
  # of them is waited on, so sweep_run_dir/stop_answers can find and stop all of
  # them even if this worker is itself stopped partway through the loop below.
  local id
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    ward session approve --session "$session" "$id" "$decision" &
    answer_pids+=("$!")
  done <<<"$ids"
  printf '%s\n' "${answer_pids[@]:-}" >"$answer_file"
  # pid_file is deliberately still here while these are outstanding: the
  # notification stays showing (possibly stale-but-harmless pending content,
  # or the one already-committed stale redraw from #250's earlier rounds)
  # rather than being retired on an optimistic guess. A refresh tick already
  # in flight when notify-send returned is still free to land its own redraw
  # in this window — the with_notiflock ordering below still guarantees the
  # locked terminal step, once it runs, is requested after any such tick, so
  # it is always the one actually left on screen.
  local p confirmed=1
  for p in "${answer_pids[@]:-}"; do
    [[ -n $p ]] || continue
    wait "$p" 2>/dev/null || confirmed=0
  done
  # Only ever reported as the real decision once every relay for it actually
  # succeeded; a partial or total failure — the daemon unreachable, the
  # approval no longer answerable (paused, expired) — says so instead of
  # claiming a decision that was never confirmed. finish_notification_self_
  # decided_locked's own `[[ -f $pid_file ]]` guard already covers "resolved
  # by some other actor in the meantime" (its terminal replace got there
  # first, so there is nothing left here to overwrite): this call is a no-op
  # in that case, not a second, conflicting terminal state.
  local final_state=$state
  [[ $confirmed -eq 1 ]] || final_state=unconfirmed
  with_notiflock "$gkey" finish_notification_self_decided_locked \
    "$pid_file" "$out" "$final_state" "${_blockargs[1]:-}"
  rm -f "$out"
}

# The short, non-actionable title a resolved notification is replaced with.
resolved_title() {
  case $1 in
    allowed) echo "Allowed elsewhere" ;;
    allowed-session) echo "Allowed for the session, elsewhere" ;;
    denied) echo "Denied elsewhere" ;;
    timed-out) echo "Timed out — denied" ;;
    session-ended) echo "Session ended — denied" ;;
    *) echo "Decided" ;;
  esac
}

# The single critical section a refresh tick (refresh_apply, below) and
# finish_notification's own terminal replace both run inside, for gkey's own
# notification (#146 item 4 review): whichever of them checks pid_file and acts
# on it *second* always sees the other's result, so a refresh can never re-show
# pending content over a notification already resolved elsewhere, and the
# terminal replace can never be raced by a refresh update landing after it —
# the same class of race #226 found one layer down, in a worker's own
# bookkeeping, moved up here to the notification's own content. Deliberately its
# own lock file, never key.lock (see the run_dir comment on .notiflock for why).
# Runs "$@" in a subshell holding the lock, the same idiom key.lock's own users
# (join_open_generation and friends) already rely on: the lock and its fd are
# released the instant that subshell exits, with no matching unlock needed.
# Exit status is whatever "$@" itself returned.
with_notiflock() {
  local gkey=$1
  shift
  (
    exec {lk}>"$run_dir/$gkey.notiflock"
    flock -x "$lk"
    "$@"
  )
}

# The shared tail of resolve_notification and sweep_run_dir: replace pid_file's
# notification in place with the outcome (`notify-send -r`, the standard-library
# `replaces_id`) so it stops offering an action nothing will honour any more, and
# reap the worker that was waiting on it. Operates on the exact files it is
# handed rather than reconstructing their names, so it never needs to know which
# (session, id) they belong to. A no-op when nothing is tracked at pid_file (no
# popup was ever shown, or its own action already resolved it — that path
# removes the pid file itself, so there is nothing here to race).
finish_notification() {
  local pid_file=$1 out_file=$2 state=$3 destination=$4
  local pid i
  # notifier_loop reserves the pid file (empty, then the real pid once notify_one
  # has backgrounded notify-send) as soon as it sees the approval pending; deciding
  # it takes real time after that (a timeout, or a person acting), so in practice
  # this loop never actually finds anything to wait for. The bounded retry (up to
  # 2s, matching wait_for_notifiers' own grace window below) is defence in depth
  # against that ordering assumption — including a slow, contended host where
  # notify_one's own fork/exec of notify-send is not yet scheduled — not reliance
  # on it.
  for ((i = 0; i < 100; i++)); do
    if [[ -f $pid_file ]]; then
      pid=$(cat "$pid_file" 2>/dev/null || true)
      [[ -n $pid ]] && break
    fi
    sleep 0.02
  done
  [[ -n ${pid:-} ]] || return 0
  # gkey from pid_file's own name ("<gkey>.pid"), never reconstructed any other
  # way, the same as every other file this function is handed.
  local gkey; gkey=$(basename "$pid_file" .pid)
  with_notiflock "$gkey" finish_notification_locked "$pid_file" "$out_file" "$state" "$destination" "$pid" || true
}

# Run under with_notiflock (see its own comment above): gkey's notification is
# only ever changed here or by a refresh tick, and only one of them at a time
# may act on it. The plain existence check finish_notification did before
# taking the lock is only ever a defence against a not-yet-reserved pid_file
# (the retry loop above); this re-check, under the very same lock a refresh
# tick holds while it does its own, is what actually decides whether there is
# still anything here to replace — a concurrent refresh tick landing in the gap
# between that first check and this lock is exactly what the lock is for.
finish_notification_locked() {
  local pid_file=$1 out_file=$2 state=$3 destination=$4 pid=$5
  [[ -f $pid_file ]] || return 0
  local notif_id
  notif_id=$(head -n1 "$out_file" 2>/dev/null || true)
  if [[ -n $notif_id ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send -a WardOS -c ward-approval -u low -t 4000 -r "$notif_id" \
      "$(resolved_title "$state")" "<tt>$(esc "$destination")</tt>" 2>/dev/null || true
  fi
  # A resolver records its daemon-confirmed terminal outcome before retiring the
  # final group member. Once the notification itself has been replaced, that
  # handoff is complete and no later sweep needs to recover it.
  rm -f "${pid_file%.pid}.resolved" "$pid_file"
  kill "$pid" 2>/dev/null || true
}

# The short, non-actionable title notify_one's own popup is replaced with once
# it has answered its own question, right here — never resolved_title's
# wording: every one of its cases says "elsewhere", which is only true for
# finish_notification's callers (resolve_notification, sweep_run_dir), never
# for this popup's own click.
decided_title() {
  case $1 in
    allowed) echo "Allowed" ;;
    allowed-session) echo "Allowed for the session" ;;
    denied) echo "Denied" ;;
    # Recognised locally, relayed, but not every relay for it actually
    # confirmed (#250 review, third round) — never claim the decision itself,
    # only that it could not be confirmed as fully applied.
    unconfirmed) echo "Could not confirm — check ward session pending" ;;
    # Nothing recognised to relay at all (dismissed, timed out, or an
    # unrecognised action) — a plain, non-actionable close, never a decision.
    closed) echo "Closed" ;;
    *) echo "Decided" ;;
  esac
}

# The self-decided counterpart of finish_notification_locked, run under the
# same with_notiflock (#250 review, second and third rounds): unlike
# finish_notification_locked, which only ever removes pid_file when it finds
# nothing left to correctly replace, this always has real content to show —
# but never a bare local guess about what was clicked (#250 review, third
# round: notify_one only calls this once it knows what actually happened —
# "closed" the instant there is nothing to relay, or "allowed"/"denied"/
# "unconfirmed" only after every relay for the decision has actually been
# waited on) — and does so in the same locked step that retires pid_file.
# That is what closes the gap a plain `with_notiflock ... rm -f "$pid_file"`
# leaves open: a tick already inside this same lock when this call queues
# behind it can still land its own stale "still pending" redraw first, but
# this always runs *after* it (with_notiflock is strictly FIFO across waiters
# on one flock), so the real, confirmed, non-actionable outcome is always the
# last thing written to the notification, never the tick's.
finish_notification_self_decided_locked() {
  local pid_file=$1 out_file=$2 state=$3 destination=$4
  [[ -f $pid_file ]] || return 0
  local notif_id
  notif_id=$(head -n1 "$out_file" 2>/dev/null || true)
  if [[ -n $notif_id ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send -a WardOS -c ward-approval -u low -t 4000 -r "$notif_id" \
      "$(decided_title "$state")" "<tt>$(esc "$destination")</tt>" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

# --- refresh_loop: #146 item 4's live-refresh half -------------------------------
#
# An already-open notification is otherwise a snapshot from the instant it opened:
# it never learns the daemon's countdown has moved on, or that the session it
# belongs to was paused or resumed after it opened. Everything below keeps one
# open popup's DECISION TIME block and progress hint current, in place
# (notify-send -r, the standard `replaces_id`), for as long as it stays open, by
# re-reading the exact same daemon-derived `fields`/`progress_value` machinery
# notifier_loop and the interactive path already use — never a parallel clock or
# pause notion of this script's own, and never anything finer-grained than the
# daemon's own Countdown (remaining_ms/timeout_ms/held), the same one #225 made
# authoritative. A held countdown's remaining_ms does not move while paused, so
# ticking through the exact same query the daemon answers for the inbox already
# holds this popup's own hint still, visibly, for exactly as long as the session
# stays paused, and resumes counting the moment it does — no special-casing here
# for pause/resume at all, only for showing whatever the daemon currently reports.

# Poll out_file (bounded, mirroring finish_notification's own pid_file poll) for
# notify-send's own --print-id line — the id a refresh tick needs to replace this
# exact notification rather than opening a second one. Read early and separately
# from notify_one's own later `tail -n1` (which waits for --wait to return): the
# id itself is written well before that, as soon as the Notify() call succeeds.
# Empty if it never appears (notify-send failed right after starting, or was
# itself killed before printing): the caller then simply never refreshes, the
# same no-live-refresh fallback as notify-send being entirely absent.
wait_for_notif_id() {
  local out_file=$1 out_var=$2 id="" i
  for ((i = 0; i < 100; i++)); do
    id=$(head -n1 "$out_file" 2>/dev/null || true)
    [[ -n $id ]] && break
    sleep 0.02
  done
  # Return through the caller's variable rather than stdout. refresh_loop is
  # intentionally killable during teardown; the old command-substitution form
  # could leave this helper writing into a pipe whose reader had just died,
  # producing the repeated "Broken pipe" noise seen in CI.
  printf -v "$out_var" '%s' "$id"
}

# One id currently gathered under gkey, read without disturbing the group — the
# same .ids file notify_one's own close_generation reads-and-clears, here only
# ever read. The first id in the file, deterministically: the same one whose
# countdown the popup's own opening progress hint already came from (notifier_loop:
# that hint is fixed from whichever line first opened this generation, never grown
# by a later duplicate joining it), so a refresh tick never contradicts the figure
# the popup opened with by tracking a different member's clock instead.
#
# Under key.lock, the same lock resolve_notification's own truncate-and-rewrite
# of this exact file already holds for its whole read-modify-write (#250 review,
# third round): an earlier, unlocked `head -n1` here could catch that rewrite
# mid-flight — reading a transiently empty or partial file exactly as a member
# is being removed — and either read a torn line or wrongly conclude the group
# had emptied while a live sibling was still being written back. Cheap even
# though it takes a lock every tick: an uncontended flock is a few syscalls,
# far under the cost of the query current_countdown_for goes on to make.
group_representative_id() {
  local gkey=$1
  local key=${gkey%.gen.*}
  (
    exec {lk}>"$run_dir/$key.lock"
    flock -x "$lk"
    head -n1 "$run_dir/$gkey.ids" 2>/dev/null || true
  )
}

# The fresh countdown field (a `fields` column: "run:<remaining_ms>:<timeout_ms>",
# "held:...", or "-") for id in session, from the daemon's own current pending
# listing — a one-shot `ward session pending --json --all`, never --follow: this
# is a poll, not a subscription, and reuses the very same `fields` jq notifier_loop
# already builds every popup's opening figure from. Every command that can fail
# (the daemon unreachable, jq erroring) is guarded so a transient failure skips
# this tick rather than taking the refresh loop down under `set -e`/pipefail
# (#225's exact class of bug, moved to this loop). Nothing, and a nonzero return,
# when the daemon no longer reports id pending at all — read by the caller as
# "already decided, elsewhere, this instant" and a cue to stop refreshing, exactly
# as a terminal record from the resolver would be.
current_countdown_for() {
  local session=$1 id=$2 line
  line=$(ward session pending --json --all 2>/dev/null | jq -r "$fields" 2>/dev/null \
    | awk -F'\t' -v id="$id" -v session="$session" '$1 == id && $2 == session { print; exit }') || true
  [[ -n $line ]] || return 1
  printf '%s\n' "$line" | cut -f13
}

# Run under with_notiflock (see its own comment): gkey's notification is still
# showing (pid_file present) — replace it in place with fresh content, the same
# actions and hints notify_one opened it with, so refreshing never drops the
# buttons that make it actionable. Exit status says whether it was still showing
# (0) or had already gone (1, the caller's cue to stop refreshing) — never which,
# if any, notify-send call itself succeeded, the same best-effort treatment of the
# notification server every other call in this script already gives it.
refresh_apply() {
  local pid_file=$1 notif_id=$2 title=$3 body=$4 progress=$5
  [[ -f $pid_file ]] || return 1
  command -v notify-send >/dev/null 2>&1 || return 0
  local hint=()
  [[ -n $progress ]] && hint=(-h "int:value:$progress")
  notify-send -a WardOS -c ward-approval -u critical -r "$notif_id" "${hint[@]}" \
    -A allow="Allow once" -A session="Allow session" -A deny="Deny" \
    "$title" "$body" >/dev/null 2>&1 || true
  return 0
}

# The live-refresh loop for one open notification, backgrounded by notify_one
# right after notify-send itself and always stopped from there too — explicitly,
# before notify_one ever removes pid_file on its own self-decided/timed-out path,
# and from its own TERM trap (sweep_run_dir's forced stop) — never left to notice
# its own notification is gone only on its own timing: that would still eventually
# self-terminate (the pid_file check below catches it within one more tick), but
# would leave sweep_run_dir's own bounded teardown unable to actually bound this
# the same way it bounds every other worker here (#226's exact class of bug,
# moved to this loop). Past notify_one itself, sweep_run_dir also reaches this
# loop directly if the worker had to be force-killed before its own TERM trap got
# a chance to stop it (stop_refresh, mirroring stop_answer, below) — the `.refresh`
# marker this writes as its own first action, mirroring `.worker`'s own reasoning,
# is what lets it.
#
# `wait_for_notif_id` and the tick loop's own `sleep` are the only blocking calls:
# neither depends on notify-send's own `--wait` (every refresh call is a separate,
# short-lived invocation, never touching $out_file), and every command that can
# fail is guarded (`|| true`/a bounded `[[ ]]` check) so a transient failure skips
# a tick rather than taking the whole loop down under `set -e` (#225's exact class
# of bug, moved to this loop).
refresh_loop() {
  local session=$1 gkey=$2 pid_file=$3 out_file=$4 title=$5
  local claim=$6 destination=$7 network=$8 method=$9 credential=${10} repository=${11} lifetime=${12}
  local refresh_file=$run_dir/$gkey.refresh
  # Mirrors notify_one's own worker_file: reserved empty by notify_one before
  # this is backgrounded, filled in here as this job's own very first action, so
  # the write and this same job's later removal (RETURN, every return path) stay
  # strictly ordered — never notify_one writing $! after backgrounding it, the
  # same race #226 found in .worker (see the run_dir comment above notify_one).
  trap 'rm -f "$refresh_file"' RETURN
  printf '%s\n' "$BASHPID" >"$refresh_file"
  local notif_id=""
  wait_for_notif_id "$out_file" notif_id
  [[ -n $notif_id ]] || return 0
  while :; do
    sleep "$refresh_interval"
    [[ -f $pid_file ]] || return 0
    local id
    id=$(group_representative_id "$gkey")
    [[ -n $id ]] || return 0
    local countdown
    # A failed query here is not on its own proof id is gone: it is the same
    # "daemon briefly unreachable"/jq hiccup `current_countdown_for`'s own doc
    # comment already promises is skipped, not fatal (#250 review, second
    # round) — and it is also what a *representative* id resolving while
    # another member of the same group is still pending looks like from here,
    # since current_countdown_for only ever looks up this one id. `continue`,
    # not `return 0`, for either: group_representative_id is re-read fresh
    # every tick (the two lines above), so the next tick picks up a still-live
    # group member on its own — a resolved representative with a live sibling
    # switches to it without this loop ever having to notice which case it
    # was — and the loop only actually stops once group_representative_id
    # itself comes back empty, meaning nothing in the group is pending any
    # more (the `[[ -n $id ]] || return 0` check above, unchanged).
    countdown=$(current_countdown_for "$session" "$id") || continue
    local held="" progress
    [[ $countdown == held:* ]] && held="held while paused · resume the session to answer"
    progress=$(progress_value "$countdown")
    local body
    body=$(blocks 1 "$claim" "$destination" "$network" "$method" "$credential" "$repository" "$lifetime" "$held")
    with_notiflock "$gkey" refresh_apply "$pid_file" "$notif_id" "$title" "$body" "$progress" || return 0
  done
}

# id, *in session*, became terminal (state, one of ApprovalRecord::state_word's
# words) with destination: resolve that session's own notification for id, never
# another live session's, even if it happens to have a pending approval with the
# same numeric id right now (#222 review: Approval::id is only unique within one
# session). The id-<session, id> marker notifier_loop wrote when id joined a group
# says exactly which notification (if any) is showing it; no marker means id was
# never folded into an open notification (no popup, or already resolved from here).
#
# id is only one member of a notification that may be showing more than one (#146
# item 7: exact duplicates share one popup) — removed from the group's ids file, not
# assumed to be its only member. Only when that empties (id was the last one still
# open — a group of one, the common case, behaves exactly as before) is the
# notification itself replaced with the outcome; otherwise the popup is left
# showing, still accurate for whatever it still represents, and notify_one relays
# the eventual decision only to what remains when it reads ids_file at answer time.
resolve_notification() {
  local id=$1 session=$2 state=$3 destination=$4
  local marker; marker=$run_dir/id-$(notif_key "$session" "$id").group
  [[ -f $marker ]] || return 0
  local gkey; gkey=$(cat "$marker" 2>/dev/null || true)
  rm -f "$marker"
  [[ -n $gkey ]] || return 0
  local key=${gkey%.gen.*} gen=${gkey##*.gen.}
  local ids_file=$run_dir/$gkey.ids lk emptied
  [[ -f $ids_file ]] || return 0
  # Reads and, if needed, rewrites ids_file inside one hold of key.lock — the same
  # lock notifier_loop's append and notify_one's own close_generation use — so this
  # can never read a membership list a concurrent append hasn't landed in yet and
  # then overwrite that append out of existence (#228 review). When id was the last
  # member, this also clears key.current here and now, in the same lock hold, if it
  # still names this exact generation — not left for notify_one's own eventual
  # close_generation to do once finish_notification below gets around to actually
  # killing the popup: a same-key request arriving in that gap would otherwise still
  # see this generation as open, join a membership file this function has already
  # deleted, and never be answered by a worker that is only moments away from
  # closing out with nothing left to relay it to (#228 review, round 3).
  emptied=$(
    exec {lk}>"$run_dir/$key.lock"
    flock -x "$lk"
    remaining=$(grep -vFx "$id" "$ids_file" 2>/dev/null || true)
    if [[ -z $remaining ]]; then
      # Persist the daemon-confirmed outcome before publishing "no members left".
      # follow_once is allowed to stop a per-session resolver once the pending
      # stream has ended; without this handoff, a resolver descheduled in the
      # tiny post-removal/pre-notification window could be killed and the generic
      # sweep would incorrectly replace the known outcome with "Session ended".
      # The sweep consumes this file if the resolver itself does not get to the
      # terminal replace first.
      printf '%s\n%s\n' "$state" "$destination" >"$run_dir/$gkey.resolved"
      rm -f "$ids_file"
      cur=$(cat "$run_dir/$key.current" 2>/dev/null || true)
      [[ $cur == "$gen" ]] && rm -f "$run_dir/$key.current"
      printf '1\n'
    else
      printf '%s\n' "$remaining" >"$ids_file"
      printf '0\n'
    fi
  )
  # Deterministic concurrency-test barrier: inert unless the test suite sets both
  # WARDOS_TESTING=1 and a private barrier prefix. This lets the regression hold
  # the resolver in the exact post-membership/pre-terminal window without changing
  # production timing or using probabilistic sleeps.
  if [[ $emptied == 1 && ${WARDOS_TESTING:-0} == 1 && -n ${WARDOS_TEST_RESOLVE_BARRIER:-} ]]; then
    : >"${WARDOS_TEST_RESOLVE_BARRIER}.reached"
    while [[ ! -f ${WARDOS_TEST_RESOLVE_BARRIER}.release ]]; do sleep 0.01; done
  fi
  [[ $emptied == 1 ]] && finish_notification "$run_dir/$gkey.pid" "$run_dir/$gkey.out" "$state" "$destination"
}

# One live session's own decided feed: resolves any of its still-showing
# notifications the moment they become terminal. Runs until this session's own
# `ward session approvals --follow` stream ends (sealed, or the daemon is gone),
# which is exactly when there is nothing left for it to watch.
resolver_for_session() {
  local session=$1
  local id state destination
  while IFS=$'\t' read -r id state destination; do
    [[ -n $id ]] || continue
    [[ $state == pending ]] && continue
    resolve_notification "$id" "$session" "$state" "$destination"
  done < <(ward session approvals --json --follow --session "$session" | jq --unbuffered -r "$approvals_fields")
}

# Start session's own resolver the first time notifier_loop sees a pending approval
# from it, and not again: one resolver per live session with an open notification,
# not one per approval, and not one global multiplexed feed (#146 items 2-3 do not
# need a `follow_pending_all`-style watcher pool of their own for this — each
# session with a notification open is already known individually, from the
# multiplexed pending stream itself).
ensure_resolver() {
  local session=$1
  local marker
  marker=$run_dir/session-$(session_key "$session").resolver
  [[ -f $marker ]] && return 0
  : >"$marker"
  resolver_for_session "$session" &
  printf '%s\n' "$!" >"$marker"
}

# Every live session's approvals, multiplexed (#141 item 4): `ward session pending
# --all --follow` fans out to every session live when it starts, not just $project's,
# so an approval in a second session is never invisible just because the bar shows the
# first. A session that starts after this round began is picked up on the next one
# (watch()'s retry loop below), the same as a session ending mid-round already is.
# Bounded: past max_notifiers still showing, a new one is left to the inbox and the
# interactive path rather than adding a worker that might wait forever. An exact
# duplicate of a notification already open — or already reserved by an earlier line
# of this same read, still ahead of notify_one in the background — never counts
# against that bound at all: it joins the group instead (#146 item 7).
notifier_loop() {
  local id session agent tool claim destination network method credential repository lifetime project countdown
  local body title key gkey held progress
  while IFS=$'\t' read -r id session agent tool claim destination network method credential repository lifetime project countdown; do
    [[ -n $id ]] || continue
    ensure_resolver "$session"
    # A running clock is the progress line alone (§10: not a number); a held one
    # also says so in words, since a line that stands still reads the same as one
    # that has not been redrawn — and an answer is refused until resume. Computed
    # before key: group_key hashes title and body, so two requests differing only
    # in a running-vs-held countdown are never folded together.
    held=""
    [[ $countdown == held:* ]] && held="held while paused · resume the session to answer"
    body=$(blocks 1 "$claim" "$destination" "$network" "$method" "$credential" "$repository" "$lifetime" "$held")
    title="${agent^} requests · ${project}"
    key=$(group_key "$session" "$title" "$body")
    # join_open_generation/open_new_generation take key.lock to check-and-append and
    # publish id's own marker atomically, so this can never land in a generation
    # notify_one's own close_generation (or resolve_notification's own empty-out) has
    # already snapshotted, and a resolver can never observe id's membership without
    # its marker already published (#228 review, rounds 1-2). A gkey either echoes
    # back is always one whose .pid/.worker already exist, from an earlier iteration
    # or an earlier round of this same key never having fully closed yet.
    gkey=$(join_open_generation "$key" "$id" "$session")
    if [[ -n $gkey ]]; then
      continue
    fi
    if [[ $(active_notifiers) -ge $max_notifiers ]]; then
      echo "wardos-approve: $max_notifiers notification(s) already open; approval $id is answerable from wardos-approve-inbox or ward session approve" >&2
      continue
    fi
    # No generation of key is currently open: mint a new one. open_new_generation
    # re-checks key.current under the same lock before doing so (see its own
    # comment) — this loop never calls it more than once for the same pending line,
    # so in practice that recheck only ever confirms what join_open_generation just
    # found, but it is what keeps the two calls' combined effect atomic rather than
    # this loop's own two separate lock acquisitions racing anything else.
    gkey=$(open_new_generation "$key" "$id" "$session")
    if [[ ! -f $run_dir/$gkey.worker ]]; then
      # Reserved here, synchronously, so the next iteration's active_notifiers
      # count is correct even before notify_one — started in the background right
      # below — has itself gotten as far as deciding whether there is even a
      # notify-send to show anything with. gkey's own gen makes its filenames
      # unique for good, so unlike the key-only names this reserved before #228,
      # nothing still live can ever have already claimed them.
      : >"$run_dir/$gkey.pid"
      # Reserved empty too, for wait_for_notifiers below to always find an entry to
      # wait on — notify_one itself fills in its own real pid, as its very first
      # action, not this loop after backgrounding it (#226 review; see the run_dir
      # comment above notify_one for why the write has to happen there instead).
      : >"$run_dir/$gkey.worker"
      # This generation's raw (pre-escape) block fields, written once, for a
      # refresh tick to re-render the DECISION TIME block and hint from a fresh
      # countdown later (#146 item 4's live-refresh half — see run_dir's own
      # comment on .blockargs, and refresh_loop). One field per line, in the exact
      # order blocks() itself takes them; safe as plain lines because every field
      # here already went through jq's own @tsv encoding on its way from the
      # daemon, which escapes an embedded tab or newline in the source value
      # (never emits either raw) — the same property the tab-separated `read`
      # above already relies on.
      printf '%s\n' "$claim" "$destination" "$network" "$method" "$credential" "$repository" "$lifetime" \
        >"$run_dir/$gkey.blockargs"
      # Here too, not as a `$(…)` argument of the backgrounded call below: bash
      # expands an asynchronous command's words in the forked child, so that would
      # put one more fork on notify_one's own timeline before its real pid reaches
      # disk — the same reason key/gkey are computed above.
      progress=$(progress_value "$countdown")
      notify_one "$session" "$gkey" "$agent" "$project" "$body" "$progress" &
    fi
  done < <(ward session pending --json --all --follow | jq --unbuffered -r "$fields")
}

# Wait up to seconds for pid to exit on its own before returning anyway.
wait_deadline() {
  local pid=$1 seconds=$2 i
  for ((i = 0; i < seconds * 20; i++)); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.05
  done
}

# Give every still-tracked notify_one worker up to seconds, in parallel (not one
# after another — bounded by the slowest single one, not their sum), to finish on
# its own: notifier_loop returning only means the pending stream itself has ended,
# not that a popup notifier_loop *just* started is abandoned — an instant answer
# (this round's mock, or a real fast click) racing the round's own end must win
# that race, not be swept as though nothing was ever going to answer it.
#
# Joins each worker's own .worker pid, not its notify-send child's .pid — the
# latter is reaped by notify_one's own `wait "$ns_pid"` well before notify_one has
# read $out, decided, and relayed the answer with `ward session approve`, so
# polling .pid alone declares a worker done while it can still be mid-flight
# (#224: the tail end of one round's worker landing a `ward` call after the next
# round, or the whole process, had already moved on and torn down its run_dir).
wait_for_notifiers() {
  local seconds=$1 worker_file pid waiters=()
  for worker_file in "$run_dir"/*.worker; do
    [[ -f $worker_file ]] || continue
    # notifier_loop reserves this file empty before notify_one starts; notify_one
    # fills in its own real pid as its very first action, so a brief empty read
    # here is the ordinary case, not a missing worker (mirrors finish_notification's
    # own retry below for .pid, and the comment on run_dir above notify_one).
    local i
    for ((i = 0; i < 100; i++)); do
      pid=$(cat "$worker_file" 2>/dev/null || true)
      [[ -n $pid ]] && break
      sleep 0.02
    done
    [[ -n $pid ]] || continue
    wait_deadline "$pid" "$seconds" &
    waiters+=("$!")
  done
  local w
  for w in "${waiters[@]:-}"; do
    [[ -n $w ]] && wait "$w" 2>/dev/null
  done
  return 0
}

# Stop every `ward session approve` call one .answer file names and establish each
# is gone: TERM, a bounded grace, then KILL, and after each a bounded wait until
# the pid no longer exists — not merely signalled. An answer is this shell's
# *grandchild* through its worker, so this cannot wait() on any of them; a
# signalled answer stays visible to `kill -0` until that worker reaps it from its
# own `wait`. So the worker is made runnable first (SIGCONT is a no-op for a
# running process, and lets a stopped one reap) — once per file, since every pid
# it names shares the one worker that gathered them (#146 item 7: a grouped
# notification relays its decision to every id it gathered, each its own `ward`
# call) — and every pid is signalled in one pass before any is waited on, so one
# slow id's grace window is not paid again by the next. The .answer marker keeps
# whichever pids are not yet confirmed gone, and is removed only once none are.
stop_answer() {
  local answer_file=$1 worker_file=${1%.answer}.worker worker="" pids p remaining=""
  pids=$(cat "$answer_file" 2>/dev/null || true)
  if [[ -z $pids ]]; then
    rm -f "$answer_file"
    return 0
  fi
  [[ -f $worker_file ]] && worker=$(cat "$worker_file" 2>/dev/null || true)
  [[ -n $worker ]] && kill -CONT "$worker" 2>/dev/null
  while IFS= read -r p; do
    [[ -n $p ]] && kill "$p" 2>/dev/null
  done <<<"$pids"
  while IFS= read -r p; do
    [[ -n $p ]] || continue
    wait_deadline "$p" 1
    if kill -0 "$p" 2>/dev/null; then
      kill -KILL "$p" 2>/dev/null || true
      [[ -n $worker ]] && kill -CONT "$worker" 2>/dev/null
      wait_deadline "$p" 2
    fi
    kill -0 "$p" 2>/dev/null && remaining="$remaining$p"$'\n'
  done <<<"$pids"
  if [[ -n $remaining ]]; then
    printf '%s' "$remaining" >"$answer_file"
  else
    rm -f "$answer_file"
  fi
}

stop_answers() {
  local answer_file
  for answer_file in "$run_dir"/*.answer; do
    [[ -f $answer_file ]] || continue
    stop_answer "$answer_file"
  done
}

# Mirrors stop_answer, for gkey's own refresh loop (#146 item 4's live-refresh
# half): only the worker that backgrounded it (notify_one, .worker's own pid) is
# refresh_loop's real parent and can wait() it — sweep_run_dir reaches it only by
# asking the worker to reap it (kill -CONT, in case stopped, so its own TERM
# trap's own cleanup, which already stops and waits its refresh_pid, gets a
# chance to run first) or, past that chance, killing it directly and polling
# `kill -0` until it is gone — the same way, and for the same reason, stop_answer
# already does for a `ward session approve` call. A single pid, not a list (a
# refresh loop is never shared the way a group's several `ward session approve`
# calls are), but otherwise the exact same shape.
stop_refresh() {
  local refresh_file=$1 worker_file=${1%.refresh}.worker worker="" pid=""
  [[ -f $worker_file ]] && worker=$(cat "$worker_file" 2>/dev/null || true)
  pid=$(cat "$refresh_file" 2>/dev/null || true)

  # An empty marker is the async-spawn handoff, not evidence that no refresh
  # child exists. The worker is the owner of that handoff. Stop the owner and
  # let its TERM trap reap whichever child it has already spawned; unlike the
  # old bounded polling loop this remains correct even if the child is
  # descheduled for arbitrarily long before publishing its own pid.
  if [[ -z $pid ]]; then
    if [[ -n $worker ]] && kill -0 "$worker" 2>/dev/null; then
      kill -CONT "$worker" 2>/dev/null || true
      kill "$worker" 2>/dev/null || true
      wait_deadline "$worker" 1
      if kill -0 "$worker" 2>/dev/null; then
        kill -KILL "$worker" 2>/dev/null || true
        wait_deadline "$worker" 2
      fi
    fi

    # If the child managed to publish during that handoff, finish it directly
    # as defence in depth. Otherwise the now-ownerless reservation is safe to
    # remove: there is no live worker left that can spawn or publish into it.
    pid=$(cat "$refresh_file" 2>/dev/null || true)
    if [[ -z $pid ]]; then
      rm -f "$refresh_file"
      return 0
    fi
  fi

  if [[ -n $worker ]]; then
    kill -CONT "$worker" 2>/dev/null || true
  fi
  kill "$pid" 2>/dev/null || true
  wait_deadline "$pid" 1
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
    if [[ -n $worker ]]; then
      kill -CONT "$worker" 2>/dev/null || true
    fi
    wait_deadline "$pid" 2
  fi
  kill -0 "$pid" 2>/dev/null || rm -f "$refresh_file"
}

stop_refreshes() {
  local refresh_file
  for refresh_file in "$run_dir"/*.refresh; do
    [[ -f $refresh_file ]] || continue
    stop_refresh "$refresh_file"
  done
}

# Whatever is still tracked once that grace window has passed did not get a
# terminal record through the ordinary path (the daemon crashed or the connection
# dropped mid-stream, not a clean seal — a clean seal gives every still-open
# approval its own terminal record before it, #146, which a resolver already turns
# into a resolve within the same window). Clear it anyway so nothing lingers into
# the next round.
sweep_run_dir() {
  local pid_file resolved_file state destination
  for pid_file in "$run_dir"/*.pid; do
    [[ -f $pid_file ]] || continue
    resolved_file=${pid_file%.pid}.resolved
    if [[ -f $resolved_file ]]; then
      state="" destination=""
      {
        IFS= read -r state || true
        IFS= read -r destination || true
      } <"$resolved_file"
      if [[ -n $state ]]; then
        finish_notification "$pid_file" "${pid_file%.pid}.out" "$state" "$destination"
        continue
      fi
    fi
    finish_notification "$pid_file" "${pid_file%.pid}.out" "session-ended" ""
  done
  # wait_for_notifiers' own grace period is a bound on how long it waits, not a
  # guarantee that nothing is still running once it elapses (#226 review): a
  # `ward session approve` call slow enough to still be going is exactly the same
  # orphan #224 was, one layer in, if left running past run_dir's removal below.
  # `kill` alone does not establish that, either (#226 review: signal delivery is
  # asynchronous — a killed pid routinely still answers `kill -0` immediately
  # afterwards) — this has to actually confirm each one is gone before returning,
  # not just have asked.
  #
  # Answers first, and completely first: stop_answers returns only once each
  # answer is actually gone — reaped by its own worker's `wait "$answer_pid"` —
  # so no worker is ever stopped while its killed answer is still unreaped.
  # Stopping a worker in that gap, or escalating it to KILL while its own TERM
  # trap (notify_one, above) is still reaping, orphans the answer alive past this
  # function's return (#226 review; reproduced by approve.test.sh with a worker
  # held descheduled across the answer's escalation). A refresh loop, if any is
  # still running, is stopped the same way and for the same reason (#146 item 4
  # review) — it answers nothing, so ordering it before or after stop_answers
  # makes no difference to that, but it must be fully stopped before its own
  # worker is, exactly like an answer.
  stop_answers
  stop_refreshes
  local worker_file answer_file refresh_file pid
  for worker_file in "$run_dir"/*.worker; do
    [[ -f $worker_file ]] || continue
    pid=$(cat "$worker_file" 2>/dev/null || true)
    # notify_one's own TERM trap exits past its RETURN trap, so its marker is
    # removed here instead.
    [[ -n $pid ]] || { rm -f "$worker_file"; continue; }
    # Its answer, if stop_answers could not yet confirm it gone, is still listed:
    # only this worker can reap it, so keep the worker runnable and give it that
    # chance before stopping it — stopping the worker first would orphan the
    # answer alive (#226 review, exact-head 07f9525). Its refresh loop, if
    # stop_refreshes could not yet confirm it gone either, gets the exact same
    # chance, for the exact same reason (#146 item 4 review).
    answer_file=${worker_file%.worker}.answer
    refresh_file=${worker_file%.worker}.refresh
    if [[ -f $answer_file ]]; then
      kill -CONT "$pid" 2>/dev/null || true
      stop_answer "$answer_file"
    fi
    if [[ -f $refresh_file ]]; then
      kill -CONT "$pid" 2>/dev/null || true
      stop_refresh "$refresh_file"
    fi
    rm -f "$worker_file"
    kill "$pid" 2>/dev/null || true
    # Its answer is already gone (stop_answers, above), so notify_one's TERM trap
    # has nothing left to reap and exits at once; the bound is generous only as a
    # backstop for a worker that is itself descheduled.
    wait_deadline "$pid" 2
    if kill -0 "$pid" 2>/dev/null; then
      kill -CONT "$pid" 2>/dev/null || true
      kill -KILL "$pid" 2>/dev/null || true
    fi
    # The worker *is* this shell's direct child (notifier_loop backgrounds it in
    # this same process), so it can — and must — actually be joined: that reaps it
    # for real rather than leaving a signalled-but-unreaped pid behind.
    wait "$pid" 2>/dev/null || true
  done
  # Anything still listed now has no worker left to reap it — an answer (or a
  # refresh loop) recorded after the first pass by a worker stopped above, or one
  # whose worker could not be made to reap in time: stop it and wait (bounded)
  # for the system's reaper.
  stop_answers
  stop_refreshes
  rm -f "$run_dir"/*.answer "$run_dir"/*.refresh
}

follow_once() {
  run_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/wardos-approve.XXXXXX")
  notifier_loop
  # Every live session's own pending stream has ended (this round of live sessions
  # sealed, or the daemon is gone). Give whatever is still open a bounded chance to
  # settle on its own — an answer already in flight, or a resolver about to catch a
  # terminal record the daemon appends before a seal (#146) — then stop every
  # per-session resolver and sweep whatever is still open regardless of whether it
  # has, so one session's stale notification or resolver can never keep this
  # listener from moving on to the next round of live sessions (#146 items 2-3).
  wait_for_notifiers 2
  local marker pid
  for marker in "$run_dir"/session-*.resolver; do
    [[ -f $marker ]] || continue
    pid=$(cat "$marker" 2>/dev/null || true)
    [[ -n $pid ]] || continue
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  sweep_run_dir
  rm -rf "$run_dir"
}

watch() {
  local once=$1
  while :; do
    follow_once || true
    [[ $once == 1 ]] && return 0
    sleep "$retry"
  done
}

case ${1:-} in
  -h|--help) usage ;;
  --watch)
    once=0
    [[ ${2:-} == --once ]] && once=1
    watch "$once"
    ;;
  --*) echo "wardos-approve: unknown option $1" >&2; usage >&2; exit 2 ;;
  *) interactive "${1:-}" "${2:-}" ;;
esac
