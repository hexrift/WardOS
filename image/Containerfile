# WardOS host image (ADR-0001: Fedora bootc, immutable, OCI-delivered; ADR-0016: the
# desktop is in the image).
#
# Stages:
#   1. `release` / `builder`  the ward binaries, from a checksum-verified release tarball
#                             or compiled from this checkout (--build-arg WARDOS_SOURCE).
#   2. the host               Fedora bootc base, every package of image/packages.txt,
#                             the binaries, the desktop tree (desktop/ placed by
#                             image/install-desktop.sh), the WardOS system configuration,
#                             the Plymouth theme.
#
# Nothing here fetches code over the network at build time except dnf from the Fedora
# repositories, cargo from crates.io (locked to Cargo.lock) and the release tarball
# (checked against its recorded SHA-256). No secrets, no `curl | sh`.
# Build with image/build.sh; turn into a disk with image/disk.sh; see image/README.md.

# ---------------------------------------------------------------------------------------
# Where the ward binaries come from. `release` (default) downloads a published release
# tarball and checks its SHA-256, so the image is reproducible from a known version and
# the tools and the image keep separate release cadences. `builder` compiles this
# checkout instead (development images, the "image build" CI job).
ARG WARDOS_SOURCE=release
ARG WARDOS_RELEASE=v0.2.0
# One checksum per architecture the release ships: WARDOS_SHA256 is the x86_64
# tarball's, WARDOS_SHA256_AARCH64 the aarch64 one's (empty here: v0.2.0 has no aarch64
# tarball; releases from v0.3 carry both, and build.sh fetches the one for --arch).
ARG WARDOS_SHA256=d67a13e5d7523b007b4d4112a8bfb1335359421daedb29f40b475cda56f6433f
ARG WARDOS_SHA256_AARCH64=

# Stage 1a: a published release. The three host binaries are required; ward-shell and
# wardos-theme-render are copied when the tarball has them (release tarballs from v0.2
# carry both; earlier ones do not, and an image built from one has no shell surfaces).
# The tarball is the one for the platform being built (`--platform linux/arm64` gives
# TARGETARCH=arm64, hence the aarch64 tarball); the stage itself runs on the build
# host's platform, since it only downloads and checks, and nothing here needs emulating.
FROM --platform=$BUILDPLATFORM docker.io/library/alpine:3.20 AS release
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
ARG WARDOS_RELEASE
ARG WARDOS_SHA256
ARG WARDOS_SHA256_AARCH64
ARG TARGETARCH
WORKDIR /out
RUN case "${TARGETARCH:-$(uname -m)}" in \
      amd64 | x86_64) arch=x86_64; sha="${WARDOS_SHA256}" ;; \
      arm64 | aarch64) arch=aarch64; sha="${WARDOS_SHA256_AARCH64}" ;; \
      *) echo "no WardOS release tarball for TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && if [ -z "$sha" ]; then \
         echo "no checksum for the ${arch} tarball of ${WARDOS_RELEASE}: pass --build-arg" \
              "WARDOS_SHA256_AARCH64 (image/build.sh --arch does) or build with WARDOS_SOURCE=builder" >&2; \
         exit 1; \
       fi \
    && name="wardos-${WARDOS_RELEASE#v}-${arch}-linux" \
    && wget -q "https://github.com/hexrift/WardOS/releases/download/${WARDOS_RELEASE}/${name}.tar.gz" \
    && echo "${sha}  ${name}.tar.gz" | sha256sum -c - \
    && tar -xzf "${name}.tar.gz" \
    && mv "${name}/ward" "${name}/wardd" "${name}/ward-agent" /out/ \
    && for optional in ward-shell wardos-theme-render; do \
         if [ -f "${name}/${optional}" ]; then mv "${name}/${optional}" /out/; \
         else echo "release ${WARDOS_RELEASE} has no ${optional} (expected from v0.2)"; fi; \
       done \
    && rm -rf "${name}" "${name}.tar.gz"

# Stage 1b: build the binaries from this checkout.
# The tag pins the same channel as rust-toolchain.toml (1.94.1); bump both together.
FROM docker.io/library/rust:1.94.1 AS builder
WORKDIR /src
# The whole workspace, filtered by the repository's .containerignore (no target/, no .git).
COPY . .
# --locked refuses to touch Cargo.lock, so the image is built from exactly the dependency
# set the repository reviewed. Five host binaries: the three of the secure-session
# layer, the shell (desktop/shell) and the theme renderer (desktop/theme).
RUN cargo build --release --locked \
      --package ward-cli \
      --package ward-daemon \
      --package ward-agent \
      --package ward-shell \
      --package wardos-theme \
    && mkdir -p /out \
    && cp target/release/ward target/release/wardd target/release/ward-agent \
          target/release/ward-shell target/release/wardos-theme-render /out/

# The chosen source, under one name for the host stage (a stage name, not an image;
# hadolint cannot tell, hence the ignore).
# hadolint ignore=DL3006
FROM ${WARDOS_SOURCE} AS binaries

# ---------------------------------------------------------------------------------------
# Stage 2: the bootable host.
# `44` pins the current Fedora release; a rebase is a deliberate edit of this line
# (image/README.md "Base image tag"; ADR-0001 addendum 2026-09: 42 went end-of-life
# and lost its COPR chroots). image/check-packages.sh and desktop/install.sh read the
# release from this line, so keep the tag a plain number.
FROM quay.io/fedora/fedora-bootc:44
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG WARDOS_VERSION=dev

LABEL org.wardos.version="${WARDOS_VERSION}" \
      containers.bootc="1" \
      org.opencontainers.image.title="WardOS host" \
      org.opencontainers.image.source="https://github.com/hexrift/WardOS" \
      org.opencontainers.image.licenses="Apache-2.0"

# Every package, with the reason for each, is in image/packages.txt (docs/desktop.md
# §Packages), and the COPRs the Hyprland pieces Fedora does not carry come from are in
# image/coprs.txt (part of the image's trust set, image/README.md "COPRs"); CI checks
# the names against this Fedora release plus those COPRs before this line ever runs. `dnf copr`
# is a dnf5 plugin, hence dnf5-plugins first; the repository files stay in the image so
# `wardos-install package` can layer from the same sources.
# Package versions follow the repositories at build time; the image digest, not
# per-package pins, is what gets recorded in evidence (hadolint DL3041 is disabled in
# .hadolint.yaml for this reason).
COPY image/coprs.txt image/packages.txt /tmp/
# install_weak_deps=False: only what the manifest names, none of the "recommended"
# extras (a smaller image, and every package in it is one somebody wrote down).
RUN dnf -y install dnf5-plugins \
    && sed -e 's/#.*//' -e '/^[[:space:]]*$/d' /tmp/coprs.txt \
       | while read -r copr; do echo "copr enable $copr"; dnf -y copr enable "$copr" || exit 1; done \
    && sed -e 's/#.*//' -e '/^[[:space:]]*$/d' /tmp/packages.txt \
       | xargs dnf -y --setopt=install_weak_deps=False install \
    && dnf clean all \
    && rm -f /tmp/packages.txt /tmp/coprs.txt

# The host binaries: ward, wardd, ward-agent (required), ward-shell and
# wardos-theme-render (present from release v0.2 and in every checkout build). /usr is
# the immutable, image-owned tree in bootc.
COPY --from=binaries /out/ /usr/bin/

# The desktop tree (docs/desktop.md §Layout): commands to /usr/bin, defaults to
# /usr/share/wardos and /etc/xdg, user units and their preset, the tty1 autologin
# drop-in for the `wardos` user. Placed by the same script desktop/install.sh uses on an
# existing Fedora, so the two installs cannot drift apart. One COPY stages the script
# beside the tree: every step here commits a multi-gigabyte layer, so steps are few.
COPY image/install-desktop.sh desktop/ /tmp/stage/
RUN test -x /usr/bin/ward && test -x /usr/bin/wardd && test -x /usr/bin/ward-agent \
    && ls -l /usr/bin/ward* \
    && /tmp/stage/install-desktop.sh /tmp/stage / \
    && rm -rf /tmp/stage

# The agents (ADR-0017): Claude Code, Codex and TamperWard at the exact versions of
# image/agents/package.json, installed by `npm ci` from its lockfile, so every tarball
# is checked against the recorded integrity hash and nothing else is fetched (no
# `curl | sh`, nothing at first boot). They live under /usr/lib/wardos/agents: image
# content, read-only, replaced by every image update like the rest of /usr (on bootc
# /opt is machine state or a read-only toplevel depending on the base, never
# something an upgrade is sure to refresh; image/README.md "Agents and TamperWard in the
# image"). Scripts are off for the install; the one postinstall the build needs, Claude
# Code's install.cjs, is run by `npm rebuild` afterwards and hard-links the native
# binary of this build's platform over bin/claude.exe (the lockfile carries the
# packages of every platform, which is what an aarch64 build needs; the musl variant
# is not for Fedora and goes). npm's cache and the agents' first-run files land in
# /tmp under a throwaway HOME, never under /root (which is /var on bootc), and are
# removed in the same step. Node must satisfy every `engines` floor (Claude Code: 22).
COPY image/agents/package.json image/agents/package-lock.json /usr/lib/wardos/agents/
RUN node --version && npm --version \
    && node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' \
    && export NODE_ENV=production HOME=/tmp/agents-home npm_config_cache=/tmp/npm-cache npm_config_update_notifier=false \
    && npm --prefix /usr/lib/wardos/agents ci --omit=dev --ignore-scripts --no-fund --no-audit \
    && npm --prefix /usr/lib/wardos/agents rebuild @anthropic-ai/claude-code \
    && rm -rf /usr/lib/wardos/agents/node_modules/@anthropic-ai/claude-code-*-musl \
    && for cmd in claude codex tamperward; do \
         ln -s "/usr/lib/wardos/agents/node_modules/.bin/$cmd" "/usr/bin/$cmd"; \
       done \
    && /usr/bin/claude --version && /usr/bin/codex --version && /usr/bin/tamperward --help >/dev/null \
    && rm -rf /tmp/agents-home /tmp/npm-cache \
    && du -sh /usr/lib/wardos/agents/node_modules

# Host configuration, laid out under image/rootfs exactly as it lands in the image
# (sysctl, tmpfiles, the two first-boot units, the Flathub script, the Plymouth theme),
# all under /usr so it ships with the image and is not user state.
COPY image/rootfs/ /

# Enable the first-boot units; pick the boot splash; sweep what package scriptlets left
# in runtime-only places; let bootc check the layout (no /var content baked in, kernel
# present, nothing under /usr/local that should be in /usr, ...). Plymouth runs from the
# initramfs, so the chosen theme has to be inside it: the initramfs is rebuilt with
# dracut the way other bootc desktops do (the "image build" job proves the step runs;
# how the splash looks at boot is E-09's to record). /var and /run must be empty in a
# bootc image (they are runtime state, created at boot by tmpfiles.d): dnf, cups and
# the software catalogue leave caches and logs there during the install, which the
# lint reports as warnings, so they go. The build engine's own mounts under /run are left
# alone: /run/systemd (docker's stub-resolv.conf) and /run/.containerenv and /run/secrets
# (podman's); none of them is in the image layer.
RUN systemctl enable wardos-firstboot.service wardos-flathub.service \
    && if rpm -q plymouth-plugin-script >/dev/null 2>&1; then plymouth-set-default-theme wardos; \
       else plymouth-set-default-theme spinner; fi \
    && kver=$(basename /usr/lib/modules/*) \
    && dracut --force --no-hostonly --reproducible --zstd --add ostree \
         --kver "$kver" "/usr/lib/modules/$kver/initramfs.img" \
    && rm -rf /var/log/* /var/cache/* /tmp/* \
    && find /run -mindepth 1 -maxdepth 1 ! -name systemd ! -name .containerenv ! -name secrets \
         -exec rm -rf {} + \
    && bootc container lint
